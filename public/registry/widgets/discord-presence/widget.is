/// @ 1.2.1
/// Discord プレゼンス ウィジェット (Lanyard + サーバーウィジェット)
/// 自分 (または指定ユーザー) の Discord の状態と Rich Presence (ゲーム名・モード・進行状況・
/// 経過時間・パーティ人数・マップ / ランク等のツールチップ) を表示し、ゲーム中はワンタップで
/// 「やってる」ノートにできる。共通サーバーの ID を入れると、そのサーバーで今ゲーム中の
/// メンバーをゲーム別に一覧する (「今フレンドが何をしているか」)。API キー不要。
///
/// ■ データ源
/// - 本人: Lanyard (https://api.lanyard.rest/v1/users/<id>)。対象ユーザーが
///   Discord の Lanyard サーバー (https://discord.gg/lanyard) に参加している必要がある
/// - フレンド: Discord 公式のサーバーウィジェット (discord.com/api/guilds/<id>/widget.json)。
///   サーバー設定 → ウィジェット を有効化してあるサーバーのみ。オンライン最大 100 人・表示名のみ
///
/// ■ 事前準備
/// 1. Discord の設定 → 詳細設定 → 開発者モードを ON にし、自分を右クリック →「ユーザー ID をコピー」
/// 2. 設定 (⚙️) にユーザー ID を貼る。フレンドも見たいならサーバーを右クリック →「サーバー ID をコピー」も貼る
///
/// 設計の元ネタ: discord-online (Lanyard) / nicolive-watch (設定 UI + 投稿ボタン)。
/// 投稿ボタンはゲーム中だけ (Spotify 再生中は listenbrainz の #nowplaying と重なるので出さない)。

// ─────────────────────────────
// ヘルパー
// ─────────────────────────────
@dflt(v, d) { if (Core:type(v) == "null") d else v }

@get(o, k, d) {
  if (Core:type(o) != "obj") { d }
  elif (Obj:has(o, k)) { dflt(o[k], d) }
  else { d }
}

@trim(s) {
  if (Core:type(s) != "str") { return "" }
  var a = 0
  var b = s.len
  loop { if (a < b && s.slice(a, a + 1) == " ") { a = a + 1 } else { break } }
  loop { if (b > a && s.slice(b - 1, b) == " ") { b = b - 1 } else { break } }
  s.slice(a, b)
}

let DIGITS = "0123456789".split("")
/// Discord の snowflake ID か (数字のみ・17〜20 桁)。URL パスへのブレイクアウトを防ぐ
@isSnowflake(s) {
  if (Core:type(s) != "str" || s.len < 17 || s.len > 20) { return false }
  var ok = true
  for (let i, s.len) { if (!DIGITS.incl(s.slice(i, i + 1))) { ok = false } }
  ok
}

/// MFM/HTML 制御文字を無害化。表示名・ゲーム名・サーバー名は外部由来なのでサニタイズ
@sanitizeText(s) {
  if (Core:type(s) != "str") { return "" }
  var txt = s.replace("$[", "$ ")
  txt = txt.replace("]", "］")
  txt = txt.replace("[", "［")
  txt = txt.replace("<", "＜")
  txt = txt.replace(">", "＞")
  txt = txt.replace("`", "｀")
  txt = txt.replace("*", "＊")
  txt = txt.replace("\\", "＼")
  txt = txt.replace("@", "＠")
  txt = txt.replace("#", "＃")
  txt = txt.replace("://", ":／／")
  txt
}

@truncName(s, n) {
  let clean = sanitizeText(s)
  if (clean.len > n) { `{clean.slice(0, n)}…` } else { clean }
}

@pad2(n) { if (n < 10) { `0{n}` } else { `{n}` } }

/// 経過時間 "30 分" / "2 時間 05 分"
@elapsed(startMs) {
  let mins = Math:floor((Date:now() - startMs) / 60000)
  if (mins < 1) { "1 分未満" }
  elif (mins < 60) { `{mins} 分` }
  else { `{Math:floor(mins / 60)} 時間 {pad2(mins % 60)} 分` }
}

// ─────────────────────────────
// 定数
// ─────────────────────────────
let REFRESH_MS = 60000 // Lanyard は 1 更新 1 リクエスト。hital.in と同じ 60 秒
let MAX_GAMES = 6       // サーバー一覧に出すゲーム数
let MAX_NAMES = 6       // ゲームごとに出す名前の数

let ACCENT = "5865f2" // Discord blurple
let MUTED  = "8a96a3"
let LINE   = "5a6573"
let GREEN  = "3dd68c"
let YELLOW = "ffb300"
let RED    = "ff6961"
let BADGE_T = "0b0d12" // チップ文字 (濃色)
let CHIP_BG = "2f3a4a" // 補足チップ (マップ / ランク) の背景
let SPOTIFY = "1db954"

/// discord_status → { col, label, icon }
@statusInfo(s) {
  if (s == "online") { { col: GREEN, label: "オンライン", icon: "●" } }
  elif (s == "idle") { { col: YELLOW, label: "退席中", icon: "🌙" } }
  elif (s == "dnd") { { col: RED, label: "取り込み中", icon: "⛔" } }
  elif (s == "offline") { { col: LINE, label: "オフライン", icon: "○" } }
  else { { col: LINE, label: "不明", icon: "?" } }
}

/// 角丸チップ。chunithm-rating / osu-stats と同じ `**　X　**` 詰め
@chip(bg, fg, label) { `$[border.radius=4 $[bg.color={bg} $[fg.color={fg} **　{label}　**]]]` }

/// 文字の繰り返し (str に repeat は無い)
@rep(ch, n) {
  var s = ""
  for (n) { s = `{s}{ch}` }
  s
}

/// パーティ人数バー "▰▰▰▱▱" (等幅)。6 人を超える party は数字だけ
@partyBar(cur, max) {
  if (max <= 0 || max > 6) { return "" }
  let filled = Math:min(max, Math:max(0, cur))
  `$[font.monospace $[fg.color={ACCENT} {rep("▰", filled)}]$[fg.color={LINE} {rep("▱", max - filled)}]]`
}

/// activity.type → 絵文字 (0 プレイ中 / 1 配信中 / 2 再生中 / 3 視聴中 / 5 競技中)
@actIcon(ty) {
  if (ty == 0) { "🎮" } elif (ty == 1) { "📡" } elif (ty == 2) { "🎵" } elif (ty == 3) { "📺" } elif (ty == 5) { "🏆" } else { "✨" }
}

// ─────────────────────────────
// 状態
// ─────────────────────────────
var userId = trim(dflt(Mk:load("dpUserId"), ""))
var guildId = trim(dflt(Mk:load("dpGuildId"), ""))
var result = null   // null = 未取得 / { error } / { unregistered: true } / { me, guild }
var hasData = false // 一度でも表示に成功したか (通信失敗時のチラつき防止)
var lastStatus = 0
var firstRun = true

// ─────────────────────────────
// データ取得
// ─────────────────────────────
@httpGet(url) {
  Nd:http(url, { method: "GET", headers: { "Accept": "application/json" } })
}

/// Lanyard の data → 表示用 { name, uname, status, platforms, custom, spotify, acts: [{icon,name,details,state,party,since,large,small,playing}] }
@parsePresence(d) {
  let du = get(d, "discord_user", {})
  let uname = get(du, "username", "")
  var platforms = []
  if (get(d, "active_on_discord_desktop", false) == true) { platforms.push("🖥️ PC") }
  if (get(d, "active_on_discord_web", false) == true) { platforms.push("🌐 Web") }
  if (get(d, "active_on_discord_mobile", false) == true) { platforms.push("📱 Mobile") }
  var custom = ""
  var acts = []
  each (let a, get(d, "activities", [])) {
    let ty = get(a, "type", -1)
    if (ty == 4) {
      let emo = get(get(a, "emoji", {}), "name", "")
      let stt = get(a, "state", "")
      custom = trim(`{emo} {stt}`)
    } elif (ty != 2 || get(d, "listening_to_spotify", false) != true) {
      let assets = get(a, "assets", {})
      let party = get(get(a, "party", {}), "size", [])
      let start = get(get(a, "timestamps", {}), "start", null)
      acts.push({
        icon: actIcon(ty)
        playing: ty == 0
        name: get(a, "name", "")
        details: get(a, "details", "")
        state: get(a, "state", "")
        party: if (Core:type(party) == "arr" && party.len == 2) { `{party[0]}/{party[1]}` } else { "" }
        partyCur: if (Core:type(party) == "arr" && party.len == 2 && Core:type(party[0]) == "num") { party[0] } else { 0 }
        partyMax: if (Core:type(party) == "arr" && party.len == 2 && Core:type(party[1]) == "num") { party[1] } else { 0 }
        since: if (Core:type(start) == "num" && start > 0) { elapsed(start) } else { "" }
        large: get(assets, "large_text", "")
        small: get(assets, "small_text", "")
      })
    }
  }
  var spotify = null
  if (get(d, "listening_to_spotify", false) == true) {
    let sp = get(d, "spotify", {})
    spotify = { song: get(sp, "song", ""), artist: get(sp, "artist", "") }
  }
  {
    name: get(du, "global_name", uname)
    uname: uname
    status: get(d, "discord_status", "offline")
    platforms: platforms.join("　")
    custom: custom
    spotify: spotify
    acts: acts
  }
}

/// widget.json → { name, online, games: [{ name, members: [] }] } (自分は除外、ゲーム無しは数えない)
@parseGuild(g, myName) {
  var byGame = {}
  var order = []
  each (let m, get(g, "members", [])) {
    let game = get(get(m, "game", {}), "name", "")
    let who = get(m, "username", "")
    if (game != "" && who != "" && who != myName) {
      if (!Obj:has(byGame, game)) { Obj:set(byGame, game, []); order.push(game) }
      byGame[game].push(who)
    }
  }
  var games = []
  each (let gname, order) { games.push({ name: gname, members: byGame[gname] }) }
  games = games.sort(@(a, b) { b.members.len - a.members.len })
  { name: get(g, "name", ""), online: get(g, "presence_count", 0), games: games }
}

@fetchGuild(myName) {
  let res = httpGet(`https://discord.com/api/guilds/{guildId}/widget.json`)
  if (res.status == 403) { return { error: "サーバーのウィジェットが無効です (サーバー設定 → ウィジェット で有効化)" } }
  if (res.status == 404) { return { error: "サーバーが見つかりません (サーバー ID を確認)" } }
  if (res.status != 200) { return { error: `サーバー情報を取得できません (HTTP {res.status})` } }
  let g = Json:parse(res.body)
  if (Core:type(g) != "obj") { return { error: "サーバー情報を読めません" } }
  parseGuild(g, myName)
}

@fetchData() {
  if (!isSnowflake(userId)) {
    result = null
    render()
    return null
  }
  let res = httpGet(`https://api.lanyard.rest/v1/users/{userId}`)
  lastStatus = res.status
  // 200 = 取得成功 / 404 = Lanyard 未登録 (どちらも JSON)。それ以外は通信失敗扱い
  if (res.status != 200 && res.status != 404) {
    if (!hasData) { result = { error: `Discord の状態を取得できません (HTTP {res.status})` }; render() }
    return null
  }
  let body = Json:parse(res.body)
  if (Core:type(body) != "obj") {
    if (!hasData) { result = { error: "Discord の状態を読めません" }; render() }
    return null
  }
  if (get(body, "success", false) != true) {
    result = { unregistered: true }
    render()
    return null
  }
  let me = parsePresence(get(body, "data", {}))
  var guild = null
  if (isSnowflake(guildId)) { guild = fetchGuild(me.uname) }
  result = { me: me, guild: guild, fetchedAt: Date:now() }
  hasData = true
  render()
}

// ─────────────────────────────
// UI 構築 (様式: steam / chunithm-rating / mewk。見出し small → 主役 x2 → 補足 small)
// ─────────────────────────────
@divider() { Ui:C:mfm({ text: `<center>$[fg.color={LINE} ───────────────]</center>` }) }

@timeLabel(ms) { `{pad2(Date:hour(ms))}:{pad2(Date:minute(ms))}` }

@configFolder(opened) {
  Ui:C:folder({
    title: "⚙️ 設定"
    opened: opened
    children: [
      Ui:C:textInput({
        // 入力ごとに fetch すると再描画でフォーカスが飛ぶので保存のみ。反映は「適用」で
        onInput: @(v) { userId = trim(v); Mk:save("dpUserId", userId) }
        default: userId
        label: "Discord ユーザー ID"
        caption: "開発者モード ON → 自分を右クリック → ユーザー ID をコピー。Lanyard サーバー参加が必要"
      })
      Ui:C:textInput({
        onInput: @(v) { guildId = trim(v); Mk:save("dpGuildId", guildId) }
        default: guildId
        label: "サーバー ID (任意)"
        caption: "ウィジェットを有効化したサーバーの ID。今ゲーム中のメンバーを一覧する"
      })
      Ui:C:button({ text: "✅ 適用して再読み込み", rounded: true, onClick: @() { fetchData() } })
    ]
  })
}

/// 投稿本文。進行状況 (state) にはスコアや相手が入るので入れない
@noteText(a) {
  var txt = `{a.icon} {a.name} やってる`
  if (a.details != "") { txt = `{txt} ({a.details})` }
  if (a.large != "" && a.large != a.details) { txt = `{txt} · {a.large}` }
  txt
}

/// 主役のアクティビティ: x2 のゲーム名 → 補足 (モード · 進行 · ⏱) → パーティバー → マップ / ランクのチップ
@heroActivity(a) {
  var lines = [ Ui:C:mfm({ text: `<center>$[x2 $[fg.color={ACCENT} **{a.icon} {truncName(a.name, 24)}**]]</center>` }) ]
  var sub = []
  if (a.details != "") { sub.push(`**{truncName(a.details, 32)}**`) }
  if (a.state != "") { sub.push(truncName(a.state, 32)) }
  if (a.since != "") { sub.push(`⏱ {a.since}`) }
  if (sub.len > 0) { lines.push(Ui:C:mfm({ text: `<center>$[fg.color={MUTED} {sub.join(" · ")}]</center>` })) }
  if (a.party != "") {
    let bar = partyBar(a.partyCur, a.partyMax)
    lines.push(Ui:C:mfm({ text: `<center>$[fg.color={MUTED} 👥] {bar} <small>$[fg.color={MUTED} {sanitizeText(a.party)}]</small></center>` }))
  }
  var chips = []
  if (a.large != "") { chips.push(chip(CHIP_BG, "ffffff", truncName(a.large, 20))) }
  if (a.small != "" && a.small != a.large) { chips.push(chip(ACCENT, "ffffff", truncName(a.small, 20))) }
  if (chips.len > 0) { lines.push(Ui:C:mfm({ text: `<center>{chips.join(" ")}</center>` })) }
  lines
}

/// 2 つ目以降のアクティビティは 1 行に畳む
@minorActivity(a) {
  var txt = `{a.icon} **{truncName(a.name, 24)}**`
  if (a.details != "") { txt = `{txt} $[fg.color={MUTED} · {truncName(a.details, 24)}]` }
  Ui:C:mfm({ text: `<center><small>{txt}</small></center>` })
}

/// サーバーで今ゲーム中のメンバー (ゲーム別)。自分と同じゲームは ✨ で強調
@guildView(g, myGame) {
  var body = [ divider() ]
  if (Obj:has(g, "error")) {
    body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 🧩 {g.error}]</small></center>` }))
    return body
  }
  body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 🧩 {truncName(g.name, 24)} · $[fg.color={GREEN} ●] {g.online} オンライン]</small></center>` }))
  if (g.games.len == 0) {
    body.push(Ui:C:mfm({ text: `<center>$[fg.color={MUTED} 💤 今ゲーム中のメンバーはいません]</center>` }))
    return body
  }
  var rows = []
  for (let i, Math:min(g.games.len, MAX_GAMES)) {
    let gm = g.games[i]
    var names = []
    for (let j, Math:min(gm.members.len, MAX_NAMES)) { names.push(truncName(gm.members[j], 16)) }
    var who = names.join(", ")
    if (gm.members.len > MAX_NAMES) { who = `{who} 他 {gm.members.len - MAX_NAMES} 人` }
    let same = if (myGame != "" && gm.name == myGame) { ` $[fg.color={GREEN} ✨ 同じ]` } else { "" }
    rows.push(Ui:C:mfm({ text: `$[fg.color={ACCENT} ▸] **{truncName(gm.name, 24)}** {chip(ACCENT, "ffffff", `{gm.members.len}`)}{same}` }))
    rows.push(Ui:C:mfm({ text: `　<small>$[fg.color={MUTED} {who}]</small>` }))
  }
  if (g.games.len > MAX_GAMES) { rows.push(Ui:C:mfm({ text: `<small>$[fg.color={MUTED} 他 {g.games.len - MAX_GAMES} タイトル]</small>` })) }
  body.push(Ui:C:container({ align: "left", children: rows }))
  body
}

@statusView(r) {
  let me = r.me
  let info = statusInfo(me.status)
  var playing = null
  var minors = []
  each (let a, me.acts) {
    if (Core:type(playing) == "null") { playing = a } else { minors.push(a) }
  }

  // 見出し: 💠 Discord · @username 　名前 + ステータスチップ
  var body = [
    Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 💠 Discord · ＠{truncName(me.uname, 24)}]</small></center>` })
    Ui:C:mfm({ text: `<center>$[fg.color={info.col} ●] **{truncName(me.name, 20)}**　{chip(info.col, BADGE_T, info.label)}</center>` })
  ]

  if (me.status == "offline") {
    body.push(Ui:C:mfm({ text: `<center>$[x2 $[fg.color={LINE} ○]]</center>` }))
    body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 💤 Discord を開いていません]</small></center>` }))
  } else {
    // 主役は 1 つ: アクティビティ > Spotify > ステータスのみ
    if (Core:type(playing) == "obj") {
      each (let l, heroActivity(playing)) { body.push(l) }
    } elif (Core:type(me.spotify) == "obj") {
      body.push(Ui:C:mfm({ text: `<center>$[x2 $[fg.color={SPOTIFY} **🎵 {truncName(me.spotify.song, 20)}**]]</center>` }))
      body.push(Ui:C:mfm({ text: `<center>$[fg.color={MUTED} {truncName(me.spotify.artist, 32)} · Spotify]</center>` }))
    } else {
      body.push(Ui:C:mfm({ text: `<center>$[x2 $[fg.color={info.col} {info.icon}]]</center>` }))
      body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 🛋️ 何もプレイしていません]</small></center>` }))
    }
    if (Core:type(playing) == "obj" && Core:type(me.spotify) == "obj") {
      body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={SPOTIFY} 🎵] **{truncName(me.spotify.song, 24)}** $[fg.color={MUTED} — {truncName(me.spotify.artist, 20)}]</small></center>` }))
    }
    each (let a, minors) { body.push(minorActivity(a)) }
    if (me.custom != "") { body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 💬 {truncName(me.custom, 40)}]</small></center>` })) }
    if (me.platforms != "") { body.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} {me.platforms}]</small></center>` })) }
  }

  if (Core:type(playing) == "obj" && playing.playing) {
    body.push(Ui:C:container({ align: "center", children: [
      Ui:C:postFormButton({ text: `{playing.icon} やってるとノートする`, primary: true, rounded: true, form: { text: noteText(playing) } })
    ] }))
  }
  let myGame = if (Core:type(playing) == "obj" && playing.playing) { playing.name } else { "" }
  if (Core:type(r.guild) == "obj") { each (let l, guildView(r.guild, myGame)) { body.push(l) } }
  body
}

@render() {
  if (!isSnowflake(userId)) {
    Ui:render([
      Ui:C:container({
        align: "center"
        padding: 10
        children: [
          Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} 💠 Discord プレゼンス]</small></center>` })
          Ui:C:mfm({ text: `<center>$[fg.color={MUTED} 🎮 Discord のユーザー ID を設定してください]</center>` })
          configFolder(true)
        ]
      })
    ])
    return null
  }
  if (firstRun && Core:type(result) == "null") {
    Ui:render([
      Ui:C:container({ align: "center", padding: 10, children: [ Ui:C:text({ text: "Discord の状態を読み込み中… 💠" }) ] })
    ])
    firstRun = false
    fetchData()
    return null
  }
  var children = []
  var footer = "60 秒ごとに更新 · Lanyard · Discord ウィジェット"
  if (Core:type(result) == "null") {
    children = [ Ui:C:container({ align: "center", children: [ Ui:C:button({ text: "🔄 更新", primary: true, rounded: true, onClick: @() { fetchData() } }) ] }) ]
  } elif (Obj:has(result, "error")) {
    children = [
      Ui:C:mfm({ text: `<center>$[fg.color={RED} ⚠️ {result.error}]</center>` })
      Ui:C:container({ align: "center", children: [ Ui:C:button({ text: "🔄 再試行", primary: true, rounded: true, onClick: @() { fetchData() } }) ] })
    ]
  } elif (Obj:has(result, "unregistered")) {
    children = [
      Ui:C:mfm({ text: `<center>$[fg.color={MUTED} 🔍 このユーザーは Lanyard に未登録です]</center>` })
      Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} discord.gg/lanyard に参加すると表示できます]</small></center>` })
      Ui:C:container({ align: "center", children: [ Ui:C:button({ text: "🔄 再試行", primary: true, rounded: true, onClick: @() { fetchData() } }) ] })
    ]
  } else {
    children = statusView(result)
    children.push(divider())
    children.push(Ui:C:container({ align: "center", children: [
      Ui:C:button({ text: "🔄 更新", rounded: true, onClick: @() { fetchData() } })
    ] }))
    footer = `最終更新 {timeLabel(result.fetchedAt)} · {footer}`
  }
  children.push(configFolder(false))
  children.push(Ui:C:mfm({ text: `<center><small>$[fg.color={MUTED} {footer}]</small></center>` }))
  Ui:render([ Ui:C:container({ align: "center", padding: 10, children: children }) ])
}

render()
Async:interval(REFRESH_MS, fetchData, false)
