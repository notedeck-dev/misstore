/// @ 1.2.1

// MFM 検索の検索エンジン変更 — 「foo 検索」の遷移先を好きな検索エンジンにする
//
// Misskey Web も NoteDeck も MFM の検索ブロック (「foo 検索」「foo [search]」など)
// の遷移先は Google 固定で、設定もプラグインのフックも無い。そこで
// Plugin:register_note_view_interruptor で表示時に検索行だけをサイレントリンク
// `?[foo 検索 (duckduckgo.com)](https://duckduckgo.com/?q=foo)` に書き換える。
// 投稿そのものは変更しない (表示専用)。見た目は検索ボックスではなく通常の
// リンクになる。
//
// 遷移先はプリセット名か https の URL だけを受け付け、それ以外 (http /
// javascript / 未知の名前) は書き換えを止めて起動時に警告する。スキームの無い
// 値 (search.example.com/?q=) には https:// を足す (### の文字列に // を書くと
// NoteDeck 1.103 までのメタデータ解析がコメントとして落とし、設定が丸ごと消える
// ため、設定の説明にも書かない。notedeck#1340)。リンクのラベルに遷移先ホストを
// 出すので、押す前にどこへ飛ぶか分かる。
//
// 書き換えない行: コードブロック内、引用 (> で始まる行)、検索語に [ ] を含む行
// (リンクのラベルが壊れる)。
//
// interruptor は同期実行なので、この中では Mk:api / Nd:call / ダイアログを使わない。
// 本家 Misskey Web にも同じフックがあるので NoteDeck 専用ではない。

### {
	name: "MFM 検索の検索エンジン変更"
	version: "1.0.1"
	author: "@hitalin"
	description: "MFM の検索ブロック (foo 検索) の遷移先を DuckDuckGo などの好きな検索エンジンにします。表示時に検索行をリンクへ書き換えるだけで、投稿そのものは変更しません"
	config: {
		engine: {
			type: "string"
			label: "検索エンジン"
			description: "プリセット名 (duckduckgo / brave / startpage / searx / google / bing) か、検索エンジンの URL (例: search.example.com/?q=)。URL は末尾に検索語が付きます。{query} を書くとその位置に入ります"
			default: "duckduckgo"
		}
	}
}

let PRESETS = {
	duckduckgo: "https://duckduckgo.com/?q={query}"
	brave: "https://search.brave.com/search?q={query}"
	startpage: "https://www.startpage.com/do/search?q={query}"
	searx: "https://search.disroot.org/search?q={query}"
	google: "https://www.google.com/search?q={query}"
	bing: "https://www.bing.com/search?q={query}"
}

// 設定値を URL テンプレートに。プリセット名でも https URL でもなければ null
@resolveTemplate(raw) {
	if (Core:type(raw) != "str") return null
	var s = raw.trim()
	let key = s.lower()
	if (Obj:has(PRESETS, key)) return Obj:get(PRESETS, key)
	if (s == "") return null
	if (s.index_of("://") == -1) s = ["https://", s].join("")
	if (!s.starts_with("https://")) return null
	if (s.index_of("{query}") != -1) return s
	[s, "{query}"].join("")
}

// テンプレートのホスト部 (https:// の後から / ? # の手前まで)
@hostOf(template) {
	let rest = template.slice(8, template.len)
	var end = rest.len
	each (let c, ["/", "?", "#"]) {
		let i = rest.index_of(c)
		if (i != -1 && i < end) end = i
	}
	rest.slice(0, end)
}

let TEMPLATE = resolveTemplate(Plugin:config.engine)
let HOST = if (TEMPLATE != null) hostOf(TEMPLATE) else ""

if (TEMPLATE == null) {
	Mk:dialog("warning", "MFM 検索の検索エンジン変更: 設定「検索エンジン」はプリセット名 (duckduckgo / brave / startpage / searx / google / bing) か https の URL にしてください。それまで検索行は書き換えません")
}

// mfm-js の検索ブロック: 行頭から「検索語 + 空白 1 文字 + ボタン」で行末。大小無視
let BUTTONS = ["[検索]", "[search]", "検索", "search"]
// AiScript の "\n" はエスケープにならないので制御文字はコードポイントから作る
let LF = Str:lf
let CRLF = [Str:from_codepoint(13), LF].join("")
let SPACES = [" ", "　", Str:from_codepoint(9)]

// 行末のボタン部分の長さ。無ければ 0
@trailingButton(line) {
	let lower = line.lower()
	each (let b, BUTTONS) {
		if (lower.ends_with(b)) return b.len
	}
	0
}

// 検索行なら { query, button } を返す。違う行や、リンクにできない行は null。
// button は行末の「検索」「search」(角括弧は外す。ラベルに入れると壊れる)
@parseSearchLine(line) {
	let bl = trailingButton(line)
	if (bl == 0) return null
	let head = line.slice(0, line.len - bl)
	if (head.len < 2) return null
	if (!SPACES.incl(head.slice(head.len - 1, head.len))) return null
	let query = head.slice(0, head.len - 1)
	if (query.index_of("[") != -1) return null
	if (query.index_of("]") != -1) return null
	let button = line.slice(line.len - bl, line.len).replace("[", "").replace("]", "")
	{ query: query, button: button }
}

@buildUrl(query) {
	// encodeURIComponent は ( ) を残すが、リンク構文の括弧と衝突するので潰す
	let q = Uri:encode_component(query).replace("(", "%28").replace(")", "%29")
	TEMPLATE.replace("{query}", q)
}

@rewrite(text) {
	let lines = text.replace(CRLF, LF).split(LF)
	var changed = false
	var inCode = false
	var parts = []
	each (let line, lines) {
		var line2 = line
		if (line.starts_with("```")) {
			inCode = !inCode
		} elif (!inCode && !line.starts_with(">")) {
			let hit = parseSearchLine(line)
			if (hit != null) {
				line2 = `?[{hit.query} {hit.button} ({HOST})]({buildUrl(hit.query)})`
				changed = true
			}
		}
		parts.push(line2)
	}
	if (changed) parts.join(LF) else text
}

Plugin:register_note_view_interruptor(@(note) {
	if (TEMPLATE != null) {
		if (Core:type(note.text) == "str") note.text = rewrite(note.text)
		if (Core:type(note.renote) == "obj" && Core:type(note.renote.text) == "str") note.renote.text = rewrite(note.renote.text)
	}
	note
})
