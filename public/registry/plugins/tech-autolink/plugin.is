/// @ 1.2.1

// 技術系オートリンク — CVE / JVN / DLsite / ニコニコ / コミットハッシュを自動リンク化
//
// misskey-tempura (taiyme 由来の tms/rj-number) が表示時に行っている
// 自動リンク化を、投稿時のテキスト変換として再現したもの。
// 表示時変換と違い Markdown リンクとして本文に残るため、
// このプラグインを入れていない閲覧者やリモートのサーバーでもリンクになる。
//
// 誤爆を避けるため、以下は変換しない:
// - コード (` / ```) の中
// - URL の中、Markdown リンク ([ラベル](URL)) の中、ハッシュタグ
// - 前後に英数字が隣接しているもの (XCVE-2024-1234 / CVE-2024-1234x など)
//
// 本文を 1 文字ずつ舐めると 1000 字前後で maxStep (100k) を超えるので、
// 各記法の先頭文字列 (CVE- / JVN / RJ / sm …) の出現位置だけを str.index_of で拾い、
// その前後だけを検査する。コミットハッシュだけは接頭辞が無いので 16 進の連なりを数える。

### {
	name: "技術系オートリンク"
	version: "1.1.0"
	author: "@hitalin"
	description: "CVE / JVN / JVNVU / JVNTA / JVNDB / DLsite / ニコニコ動画 / GitHub コミットハッシュを投稿時に自動でリンクにします"
	config: {
		security: {
			type: "boolean"
			label: "セキュリティ情報 (CVE / JVN / JVNVU / JVNTA / JVNDB)"
			default: true
		}
		dlsite: {
			type: "boolean"
			label: "DLsite (RJ / RE / VJ / VE / BJ / BE / RG など)"
			default: true
		}
		nicovideo: {
			type: "boolean"
			label: "ニコニコ動画 (sm / nm / so)"
			default: true
		}
		githubCommit: {
			type: "boolean"
			label: "GitHub コミットハッシュ (40 桁)"
			default: true
		}
		autoConvert: {
			type: "boolean"
			label: "投稿時に自動で変換する"
			description: "オフの場合は投稿フォームのプラグインメニューから手動で変換します"
			default: false
		}
	}
}

let DIGITS = "0123456789"
let HEXCHARS = "0123456789abcdefABCDEF"
let WORDCHARS = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

@isWordChar(c) {
	// 空文字に対して incl は true を返すため明示的に除く
	c != "" && WORDCHARS.incl(c)
}

@isBreak(c) {
	c == " " || c == "　" || c == Str:lf
}

@sub(chars, from, to) {
	chars.slice(from, to).join("")
}

// chars[start] から allowed に含まれる文字を読み進める
@readRun(chars, start, allowed) {
	var i = start
	loop {
		if (i >= chars.len) break
		if (!allowed.incl(chars[i])) break
		i += 1
	}
	{
		value: sub(chars, start, i)
		next: i
	}
}

// chars の i 文字目から word が (大文字小文字を無視して) 続くか
@startsWith(chars, i, word) {
	let n = word.split().len
	if (i + n > chars.len) return false
	sub(chars, i, i + n).lower() == word.lower()
}

// --- 各記法のマッチャー: 成立すれば { label, url, next }、しなければ null ---

// CVE-2024-1234
@matchCve(chars, i) {
	if (!startsWith(chars, i, "CVE-")) return null
	let year = readRun(chars, i + 4, DIGITS)
	if (year.value.len != 4) return null
	if (year.next >= chars.len || chars[year.next] != "-") return null
	let seq = readRun(chars, year.next + 1, DIGITS)
	if (seq.value.len < 4) return null
	let label = sub(chars, i, seq.next)
	{
		label: label
		url: `https://www.cve.org/CVERecord?id={label.upper()}`
		next: seq.next
	}
}

// JVNDB-2024-000001
@matchJvndb(chars, i) {
	if (!startsWith(chars, i, "JVNDB-")) return null
	let year = readRun(chars, i + 6, DIGITS)
	if (year.value.len != 4) return null
	if (year.next >= chars.len || chars[year.next] != "-") return null
	let seq = readRun(chars, year.next + 1, DIGITS)
	if (seq.value.len != 6) return null
	let label = sub(chars, i, seq.next)
	{
		label: label
		url: `https://jvndb.jvn.jp/en/contents/{year.value}/{label.upper()}.html`
		next: seq.next
	}
}

// JVN#12345678 / JVNVU#12345678 / JVNTA#12345678
@matchJvnFamily(chars, i, prefix, path) {
	if (!startsWith(chars, i, prefix)) return null
	let body = readRun(chars, i + prefix.len, `#{DIGITS}`)
	if (body.value.len < 8) return null
	let label = sub(chars, i, body.next)
	{
		label: label
		url: `https://jvn.jp/{path}/{label.replace("#", "").upper()}/index.html`
		next: body.next
	}
}

// RJ123456 (作品) / RG12345 (サークル)
@matchDlsite(chars, i) {
	if (i + 1 >= chars.len) return null
	if (!"RVB".incl(chars[i])) return null
	let kind = chars[i + 1]
	if ("JE".incl(kind)) {
		let num = readRun(chars, i + 2, DIGITS)
		if (num.value.len < 6) return null
		let label = sub(chars, i, num.next)
		return {
			label: label
			url: `https://www.dlsite.com/home/work/=/product_id/{label}.html`
			next: num.next
		}
	}
	if (kind == "G") {
		let num = readRun(chars, i + 2, DIGITS)
		if (num.value.len < 5) return null
		let label = sub(chars, i, num.next)
		return {
			label: label
			url: `https://www.dlsite.com/home/circle/profile/=/maker_id/{label}.html`
			next: num.next
		}
	}
	null
}

// sm9 / nm12345 / so12345
@matchNico(chars, i) {
	if (i + 1 >= chars.len) return null
	let head = `{chars[i]}{chars[i + 1]}`
	if (head != "sm" && head != "nm" && head != "so") return null
	let num = readRun(chars, i + 2, DIGITS)
	if (num.value.len < 1) return null
	let label = sub(chars, i, num.next)
	{
		label: label
		url: `https://www.nicovideo.jp/watch/{label}`
		next: num.next
	}
}

// JVN 系は前方一致が長いものから試す
@matchJvn(chars, i) {
	var hit = matchJvndb(chars, i)
	if (hit == null) hit = matchJvnFamily(chars, i, "JVNVU", "vu")
	if (hit == null) hit = matchJvnFamily(chars, i, "JVNTA", "ta")
	if (hit == null) hit = matchJvnFamily(chars, i, "JVN", "jp")
	hit
}

// --- 変換対象外の判定 (候補ごとに前後を見る) ---

// 1 回の変換で処理する上限。同じ記法を数百個並べた本文でもステップ上限に届かないようにする
let MAX_LINKS = 100

// [ラベル](URL) の終端。成立しなければ null
@readMdLink(chars, i) {
	var j = i + 1
	loop {
		if (j >= chars.len) return null
		let c = chars[j]
		if (c == "]") break
		if (c == Str:lf) return null
		j += 1
	}
	if (j + 1 >= chars.len || chars[j + 1] != "(") return null
	var k = j + 2
	loop {
		if (k >= chars.len) return null
		let c = chars[k]
		if (c == ")") break
		if (isBreak(c)) return null
		k += 1
	}
	k + 1
}

// 空白区切りの直前部分 (候補を含むトークンの先頭から候補まで)
@tokenBefore(before) {
	let a = before.split(Str:lf)
	let b = a[a.len - 1].split(" ")
	let c = b[b.len - 1].split("　")
	c[c.len - 1]
}

// start〜next の範囲をリンクにしてよいか
@isLinkable(chars, start, next) {
	// 前後に英数字が隣接しているものは語の一部とみなす
	if (start > 0 && isWordChar(chars[start - 1])) return false
	if (next < chars.len && isWordChar(chars[next])) return false
	let before = sub(chars, 0, start)
	// ` の数が奇数ならコードの中 (``` も 1 文字ずつ数えて辻褄が合う)
	if ((before.split("`").len - 1) % 2 == 1) return false
	// URL / ハッシュタグを含むトークンの中
	let tok = tokenBefore(before)
	if (tok.incl("https://") || tok.incl("http://")) return false
	if (tok.starts_with("#")) return false
	// 同じ行の [ラベル](URL) の中
	let lines = before.split(Str:lf)
	let lineStart = start - lines[lines.len - 1].split().len
	var q = chars.index_of("[", lineStart)
	loop {
		if (q < 0 || q >= start) break
		let end = readMdLink(chars, q)
		if (end != null && end > start) return false
		q = chars.index_of("[", q + 1)
	}
	true
}

// 候補位置 p で記法 (matcher) が成立し、変換してよければ hits に積む
@collect(hits, chars, p, matcher) {
	if (hits.len >= MAX_LINKS) return null
	if (p > 0 && isWordChar(chars[p - 1])) return null
	let hit = matcher(chars, p)
	if (hit == null) return null
	if (!isLinkable(chars, p, hit.next)) return null
	hits.push({ start: p, next: hit.next, label: hit.label, url: hit.url })
}

// haystack 中の needle の出現位置すべてを候補にする
// (str.index_of と split() はどちらもコードポイント単位なので添字を混ぜてよい)
@collectByNeedle(hits, chars, haystack, needle, matcher) {
	var p = haystack.index_of(needle, 0)
	loop {
		if (p < 0 || hits.len >= MAX_LINKS) break
		collect(hits, chars, p, matcher)
		p = haystack.index_of(needle, p + 1)
	}
}

// 接頭辞の無いコミットハッシュ (SHA-1、64 桁の SHA-256 などは長さで弾く) は、16 進がちょうど 40 文字連なる位置を候補にする。
// 40 文字の連なりは 40 文字おきの標本 (39, 79, …) のどれかを必ず含むので、標本が 16 進のときだけ
// 前後に広げて連なりの範囲を求める (本文全体を 1 文字ずつ見ない)
@collectHashes(hits, chars) {
	let n = chars.len
	var j = 39
	loop {
		if (j >= n || hits.len >= MAX_LINKS) break
		if (HEXCHARS.incl(chars[j])) {
			var s = j
			loop {
				if (s > 0 && HEXCHARS.incl(chars[s - 1])) s -= 1
				else break
			}
			var e = j + 1
			loop {
				if (e < n && HEXCHARS.incl(chars[e])) e += 1
				else break
			}
			if (e - s == 40) {
				// 範囲は確定しているので readRun で読み直さない
				let hex = sub(chars, s, e)
				collect(hits, chars, s, @(c, p) {
					{ label: hex, url: `https://github.com/search?q={hex}&type=commits`, next: e }
				})
			}
			// 次の連なりは e + 1 以降にしか始まらない
			j = e + 40
		} else {
			j += 40
		}
	}
}

@convertLinks(text, opts) {
	let chars = text.split()
	// 大文字小文字を無視する記法は小文字化した本文で探す (lower で長さが変わる文字があれば諦めて原文で探す)
	var lowered = text.lower()
	if (lowered.len != text.len) lowered = text
	var hits = []
	if (opts.security) {
		collectByNeedle(hits, chars, lowered, "jvn", matchJvn)
		collectByNeedle(hits, chars, lowered, "cve-", matchCve)
	}
	if (opts.dlsite) {
		each (let needle, ["RJ", "RE", "VJ", "VE", "BJ", "BE", "RG"]) {
			collectByNeedle(hits, chars, text, needle, matchDlsite)
		}
	}
	if (opts.nicovideo) {
		each (let needle, ["sm", "nm", "so"]) {
			collectByNeedle(hits, chars, text, needle, matchNico)
		}
	}
	if (opts.githubCommit) collectHashes(hits, chars)

	// 出現順に並べ、重なるもの (同じ位置に複数の記法が成立した場合など) は先のものを優先する
	hits.sort(@(a, b) { a.start - b.start })
	var parts = []
	var count = 0
	var segStart = 0
	each (let hit, hits) {
		if (hit.start >= segStart) {
			parts.push(sub(chars, segStart, hit.start))
			parts.push(`[{hit.label}]({hit.url})`)
			count += 1
			segStart = hit.next
		}
	}
	parts.push(sub(chars, segStart, chars.len))
	{
		text: parts.join("")
		count: count
	}
}

@currentOpts() {
	{
		security: Plugin:config.security
		dlsite: Plugin:config.dlsite
		nicovideo: Plugin:config.nicovideo
		githubCommit: Plugin:config.githubCommit
	}
}

Plugin:register_post_form_action("リンクに変換", @(form, update) {
	let text = if (form.text == null) "" else form.text
	let result = convertLinks(text, currentOpts())
	if (result.count == 0) {
		Mk:dialog("技術系オートリンク", "リンクにできる記法が見つかりません", "info")
		return null
	}
	update("text", result.text)
	Mk:toast(`{result.count} 件をリンクにしました`, "success")
})

Plugin:register_note_post_interruptor(@(note) {
	if (Plugin:config.autoConvert && note.text != null) {
		note.text = convertLinks(note.text, currentOpts()).text
	}
	note
})
