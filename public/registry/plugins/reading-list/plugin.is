/// @ 1.2.1

// 後で読む — ノートメニュー / キー 1 つで「後で読む」クリップへ送る
//
// Pocket 的な「後で読む」ワークフローの入口。ウィジェット「後で読む」(reading-list-widget)
// と同じ名前のクリップ (既定「後で読む」、設定 clipName で変更可) を共有し、
// プラグインで溜めてウィジェットで消化する。
//
// 入口は 3 つ:
//   - ノートメニュー「後で読む」(本家 Web 互換のフック。実行は NoteDeck 専用)
//   - コマンド「後で読む: フォーカス中のノートを追加」
//       column.focusedNote で今フォーカスしているノートを取る。キーバインド設定の
//       「プラグイン」節でキーを割り当てると、カラムで j/k しながら 1 キーで溜められる
//   - コマンド「後で読む: クリップボードのノート URL を追加」
//       clipboard.read のテキストが https://<host>/notes/<id> なら Mk:api("ap/show")
//       で (リモートのノートでも) 自分のサーバー上のノートに解決して追加する。
//       OS グローバルショートカットに割り当てると、ブラウザで URL をコピー → キー
//       1 つで NoteDeck に溜まる (NoteDeck が背面でも動く)
//   コマンドへのキーバインドは NoteDeck 1.85.2 から届く (notedeck#1243)。
//
// クリップ id はサーバー / アカウントごとに違うので名前で解決する:
//   1. Mk:save に覚えた { name, id } がアカウント・名前とも一致すれば clips.list を省く
//   2. 無ければ clips.list から名前一致を探す
//   3. それも無ければ clips.create で非公開クリップを作る (確認ダイアログあり)
// 続けて clips.addNote (確認ダイアログあり) → トースト。
//
// アカウントは、ノートメニューなら note._accountId、フォーカス中なら
// column.focusedNote の accountId を clips.* に明示する。クリップボードからは
// 呼び出し文脈 (active) のアカウントで、記憶の鍵だけ account.current から引く。
//
// Nd:call はキャンセル時だけ error 値 (user_cancelled) を返し、それ以外の失敗
// (クリップが削除済み等) は throw して handler がそこで止まる。AiScript に try/catch は
// 無いので、addNote を呼ぶ「前」に覚えた id を捨て、戻ってきたら書き戻す。
// throw した回は書き戻しが走らないため、次回は clips.list から解決し直す。
// NoteDeck の Mk:api も失敗時は throw する (ap/show が解決できない URL など)。
//
// quick-clip との違い: クリップ id を設定しなくてよく、無ければ自動で作る。
// 消化 (読んだ → クリップから外す) はウィジェット側が担当する。
//
// NoteDeck 専用。使う NoteDeck 権限 (meta.json に記載):
//   - clips.read   … clips.list   (名前からクリップを探す)
//   - clips.write  … clips.create (無ければ作成) / clips.addNote (追加)
//   - notes.read   … column.focusedNote (フォーカス中のノート)
//   - clipboard    … clipboard.read (ノート URL の取り込み)
//   - account.read … Mk:api("ap/show") (URL をノートに解決) / account.current (記憶の鍵)

### {
	name: "後で読む"
	version: "1.1.0"
	author: "@hitalin"
	description: "ノートメニュー、またはコマンド (フォーカス中のノート / クリップボードのノート URL) から「後で読む」クリップに追加します。クリップが無ければ自動で作成。コマンドにキーを割り当てると 1 キーで溜められます。ウィジェット「後で読む」と対で使うと一覧・既読化ができます (NoteDeck 専用)"
	config: {
		clipName: {
			type: "string"
			label: "クリップ名"
			description: "ウィジェット「後で読む」のクリップ名と同じにしてください"
			default: "後で読む"
		}
	}
}

let title = "後で読む"
let defaultName = "後で読む"
// Mk:save の鍵。値は { "<accountId>": { name, id } | null }
let storeKey = "clips"

@clipName() {
	let n = Plugin:config.clipName.trim()
	if (n == "") defaultName else n
}

// accountId が分かっているときだけ params に足す (null なら呼び出し文脈のアカウント)
@withAccount(params, accountId) {
	if (accountId != null) params.accountId = accountId
	params
}

// 記憶の鍵。accountId が無ければ account.current から引き、それも無ければ単一鍵に倒す
@storeKeyOf(accountId) {
	if (accountId != null) return accountId
	let cur = Nd:call("account.current", {})
	if (Core:type(cur) == "obj" && Core:type(cur.id) == "str") cur.id else "default"
}

// (`else {}` は空ブロックに解釈されるので、空オブジェクトは let で作る)
@loadStore() {
	let v = Mk:load(storeKey)
	if (Core:type(v) == "obj") return v
	let empty = {}
	empty
}

@remember(key, entry) {
	let store = loadStore()
	store[key] = entry
	Mk:save(storeKey, store)
}

// 覚えている id (名前が一致するときだけ)。無ければ null
@rememberedId(key, name) {
	let store = loadStore()
	if (!Obj:has(store, key)) return null
	let e = store[key]
	if (Core:type(e) != "obj" || e.name != name || Core:type(e.id) != "str") return null
	e.id
}

// clips.list で名前一致を探す。見つからなければ null
@findClip(name, accountId) {
	let clips = Nd:call("clips.list", withAccount({}, accountId))
	if (Core:type(clips) != "arr") return null
	each (let c, clips) {
		if (Core:type(c) == "obj" && c.name == name && Core:type(c.id) == "str") return c.id
	}
	null
}

// 探して無ければ作る。作成をキャンセルされたら null
@resolveClip(name, accountId) {
	let found = findClip(name, accountId)
	if (found != null) return found
	let created = Nd:call("clips.create", withAccount({ name: name, description: "reading-list プラグインが作成", isPublic: false }, accountId))
	if (Core:type(created) == "error") return null
	if (Core:type(created) != "obj" || Core:type(created.id) != "str") {
		Mk:dialog(title, "クリップを作成できませんでした", "error")
		return null
	}
	created.id
}

// noteId を「後で読む」クリップへ追加する。accountId が null なら呼び出し文脈のアカウント
@addToList(noteId, accountId) {
	let name = clipName()
	let key = storeKeyOf(accountId)
	var clipId = rememberedId(key, name)
	if (clipId == null) {
		clipId = resolveClip(name, accountId)
		// 作成の確認ダイアログでキャンセルされた
		if (clipId == null) return null
	}
	// addNote が throw した回 (クリップ削除済み等) は書き戻しが走らず、次回は解決し直す
	remember(key, null)
	let added = Nd:call("clips.addNote", withAccount({ clipId: clipId, noteId: noteId }, accountId))
	remember(key, { name: name, id: clipId })
	// 追加の確認ダイアログでキャンセルされた
	if (Core:type(added) == "error") return null
	Mk:toast(`「{name}」に追加しました`, "success")
	null
}

// クリップボードのテキストが https://<host>/notes/<id> なら、クエリや断片を落とした
// ノート URL を返す。違えば null
@noteUrlOf(text) {
	let t = text.trim()
	if (!t.starts_with("https://")) return null
	let parts = t.split("/notes/")
	if (parts.len != 2) return null
	let host = parts[0].slice(8, parts[0].len)
	if (host == "" || host.incl("/")) return null
	var id = parts[1]
	each (let sep, ["/", "?", "#"]) {
		let i = id.index_of(sep)
		if (i >= 0) id = id.slice(0, i)
	}
	if (id == "") return null
	`https://{host}/notes/{id}`
}

Plugin:register_note_action("後で読む", @(note) {
	if (!(exists NOTEDECK)) {
		Mk:dialog(title, "このプラグインは NoteDeck 専用です。Misskey Web では動作しません", "info")
		return null
	}
	// NoteDeck のノートには取得アカウントが _accountId で付く
	let accountId = if (Obj:has(note, "_accountId") && Core:type(note._accountId) == "str") note._accountId else null
	addToList(note.id, accountId)
})

if (exists NOTEDECK) {
	Nd:register_command("add-focused", "後で読む: フォーカス中のノートを追加", "ti-bookmark", @() {
		let focused = Nd:call("column.focusedNote", {})
		if (Core:type(focused) != "obj" || focused.note == null || Core:type(focused.noteId) != "str") {
			Mk:toast("追加するノートをカラムでフォーカスしてください")
			return null
		}
		let accountId = if (Core:type(focused.accountId) == "str") focused.accountId else null
		addToList(focused.noteId, accountId)
	})

	Nd:register_command("add-clipboard", "後で読む: クリップボードのノート URL を追加", "ti-clipboard-text", @() {
		let clip = Nd:call("clipboard.read", {})
		let text = if (Core:type(clip) == "obj" && Core:type(clip.text) == "str") clip.text else ""
		let uri = noteUrlOf(text)
		if (uri == null) {
			Mk:dialog(title, "クリップボードに Misskey のノート URL (https://…/notes/…) がありません", "info")
			return null
		}
		// ap/show はリモートのノートも自分のサーバー上のノートに解決する
		let res = Mk:api("ap/show", { uri: uri })
		if (Core:type(res) != "obj" || res.type != "Note" || Core:type(res.object) != "obj" || Core:type(res.object.id) != "str") {
			Mk:dialog(title, "ノートとして取得できませんでした", "error")
			return null
		}
		addToList(res.object.id, null)
	})
} else {
	Mk:toast("後で読むは NoteDeck 専用です (Misskey Web では動作しません)")
}
