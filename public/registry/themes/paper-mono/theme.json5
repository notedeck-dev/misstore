		codeEditorBg: '#ffffff',
		codeEditorFg: '#111111',
		codeEditorFgMuted: '#555555',
		codeEditorPanelBg: '#f2f2f2',
		codeEditorPanelBorder: '#7a7a7a',
		codeEditorSelectionBg: '#d0d0d0',
		codeEditorActiveItemBg: '#dcdcdc',
		codeEditorCaret: '#000000',
		codeEditorGutterFg: '#666666',
		codeEditorGutterActiveFg: '#111111',
		codeEditorActiveLineBg: 'rgba(0, 0, 0, 0.04)',
		codeEditorMatchBg: 'rgba(0, 0, 0, 0.15)',
		codeEditorMatchBorder: '#111111',
		codeKeyword: '#000000',
		codeComment: '#666666',
		codeVariable: '#222222',
		codeFunction: '#333333',
		codeType: '#444444',
		codeLink: '#4a4a4a',
		// 差分は濃淡で区別 (挿入 = 薄い / 削除 = 濃い)
		diffInsertBg: 'rgba(0, 0, 0, 0.05)',
		diffInsertTextBg: 'rgba(0, 0, 0, 0.14)',
		diffDeleteBg: 'rgba(0, 0, 0, 0.18)',
		diffDeleteTextBg: 'rgba(0, 0, 0, 0.35)',
	},
}
