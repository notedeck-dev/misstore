{
	id: 'b791fe71-f23e-4988-ba71-4cabbb80b488',
	base: 'light',
	name: 'ペーパーモノ',
	desc: 'e-ink / 紙のようなグレースケールのライト。影なし・角丸なし・アニメーションなし (duration を 0s)。本文は明朝系フォント',
	props: {
		// 色はすべて無彩色。意味の区別はアイコンと濃淡だけに任せる
		bg: '#f2f2f2',
		fg: '#111111',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		// リンクは本文よりやや薄い灰で区別する
		link: '#4a4a4a',
		warn: '#4d4d4d',
		badge: '@accent',
		error: '#000000',
		focus: ':alpha<0.25<@accent',
		navBg: '@panel',
		navFg: '@fg',
		panel: '#ffffff',
		popup: '#ffffff',
		accent: '#3a3a3a',
		header: '@panel',
		infoBg: '#e6e6e6',
		infoFg: '@fg',
		renote: '#555555',
		shadow: 'rgba(0, 0, 0, 0)',
		divider: '#7a7a7a',
		hashtag: '#4a4a4a',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.5)',
		success: '#333333',
		love: '#222222',
		buttonBg: '#e6e6e6',
		buttonHoverBg: '#d9d9d9',
		switchBg: '#bfbfbf',
		indicator: '@accent',
		mentionMe: '#000000',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.1<@accent',
		codeNumber: '#333333',
		codeString: '#555555',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#111111',
		infoWarnBg: '#dcdcdc',
		infoWarnFg: '#111111',
		codeBoolean: '#444444',
		dateLabelFg: '@fg',
		inputBorder: '#7a7a7a',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#000000',
		panelHeaderBg: '@panel',
		panelHeaderFg: '@fg',
		panelHighlight: '#f2f2f2',
		windowHeader: '#ffffff',
		folderHeaderBg: '#ebebeb',
		folderHeaderHoverBg: '#dedede',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		scrollbarHandle: 'rgba(0, 0, 0, 0.35)',
		inputBorderHover: '#111111',
		scrollbarHandleHover: 'rgba(0, 0, 0, 0.6)',
		deckBg: '#e8e8e8',

		// ---- NoteDeck 独自 ----
		accentText: '#3a3a3a',
		fgMuted: '#555555',
		focusRing: '#000000',
		hairline: '#8f8f8f',
		overlayDark: 'rgba(0, 0, 0, 0.5)',
		overlayLightbox: 'rgba(0, 0, 0, 0.9)',
		inlineCodeBg: '#e6e6e6',
		inlineCodeFg: '@fg',
		'bg-secondary': 'rgba(0, 0, 0, 0.06)',
		// 影なし
		'shadow-contact': 'rgba(0, 0, 0, 0)',
		'shadow-ambient': 'rgba(0, 0, 0, 0)',
		// 角丸なし (radius-full はアバター・ピル用なので残す)
		'radius-xs': '0px',
		'radius-sm': '0px',
		'radius-md': '0px',
		'radius-lg': '0px',
		radius: '0px',
		'radius-sheet': '0px',
		// アニメーションなし。OS の prefers-reduced-motion 無しでも静止させる
		'duration-fast': '0s',
		'duration-base': '0s',
		'duration-medium': '0s',
		'duration-slow': '0s',
		'duration-slower': '0s',
		'duration-tl-enter': '0s',
		// 本文は明朝系。e-ink 端末の既定書体に揃える
		'font-sans': "'Hiragino Mincho ProN', 'Yu Mincho', YuMincho, 'BIZ UDMincho', 'Noto Serif JP', 'Noto Serif CJK JP', Georgia, 'Times New Roman', serif",
		// 半透明ヘッダーも不透明に
		'header-opacity': '1',
		// 通知アイコンの塗り (白アイコンが乗る)。濃淡で 7 種を分ける
