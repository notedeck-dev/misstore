{
	id: 'b4006d9f-4a66-416d-89d1-9db7641c32c9',
	base: 'light',
	name: 'GTK Classic',
	desc: 'GNOME 2 の既定テーマ Clearlooks の配色。#edeceb の素っ気ない事務グレーに水色の選択色',
	props: {
		bg: '#edeceb',
		fg: '#1a1a1a',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		// GTK2 の既定リンク色 (GtkWidget の link-color / visited-link-color)
		link: '#0000ee',
		warn: '#c4a000',
		badge: '#cc0000',
		error: '#a40000',
		focus: 'rgba(134, 171, 217, 0.5)',
		navBg: '#edeceb',
		navFg: '#4c4c4c',
		panel: '#ffffff',
		popup: '#ffffff',
		// Clearlooks の selected_bg_color
		accent: '#86abd9',
		header: '#e5e4e2',
		infoBg: '#e4ecf7',
		infoFg: '@fg',
		renote: '#4e9a06',
		shadow: 'rgba(0, 0, 0, 0.2)',
		divider: '#bebdbb',
		hashtag: '#551a8b',
		mention: '@link',
		modalBg: 'rgba(0, 0, 0, 0.4)',
		success: '#4e9a06',
		switchBg: '#b7b6b4',
		indicator: '#cc0000',
		mentionMe: '@mention',
		messageBg: '@bg',
		navActive: '@link',
		accentedBg: 'rgba(134, 171, 217, 0.25)',
		codeNumber: '#ce5c00',
		codeString: '#a40000',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#1a1a1a',
		// Clearlooks の tooltip_bg_color
		infoWarnBg: '#f5f5b5',
		infoWarnFg: '#6b5400',
		codeBoolean: '#204a87',
		dateLabelFg: '@fg',
		inputBorder: '#b7b6b4',
		panelBorder: '" 1px solid #bebdbb',
		navIndicator: '@indicator',
		fgHighlighted: '#000000',
		// GTK2 のツールバー / ヘッダにあった縦方向のごく浅いグラデーション
		panelHeaderBg: '" linear-gradient(180deg, #f2f1f0, #e3e2e0)',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '#edeceb',
		panelHighlight: '#f7f6f5',
		scrollbarHandle: 'rgba(0, 0, 0, 0.3)',
		inputBorderHover: '#86abd9',
		scrollbarHandleHover: 'rgba(0, 0, 0, 0.5)',
		deckBg: '#dcdbda',
	},
}
