{
	id: '4a175bfe-3638-4697-b6d8-80d0c8320554',
	base: 'dark',
	name: 'CUD ダーク',
	desc: '色覚多様性 (CUD) 向けのダーク。Okabe-Ito パレットで赤緑の対立を青と朱に置き換え、成功 = 青 / エラー = 朱、挿入 = 青 / 削除 = 朱。本文は WCAG AA 以上',
	props: {
		// 大面積はわずかに青みのある無彩色。色の判別は Okabe-Ito の 7 色だけに任せる
		bg: '#16181d',
		fg: '#e6e6e6',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		// 空色 #56B4E9 (Okabe-Ito sky blue)
		link: '#56b4e9',
		// 黄 #F0E442 (yellow)
		warn: '#f0e442',
		badge: '@accent',
		// 朱 #D55E00 (vermilion) を暗背景で読めるよう明度だけ上げたもの
		error: '#f4883b',
		focus: ':alpha<0.35<@accent',
		navBg: '@panel',
		navFg: '@fg',
		panel: '#1f2228',
		popup: '#262a31',
		accent: '#56b4e9',
		header: ':alpha<0.7<@panel',
		infoBg: '#0f3a56',
		infoFg: '#e6e6e6',
		// 青緑 #009E73 (bluish green) を暗背景向けに明度を上げたもの
		renote: '#2fc695',
		shadow: 'rgba(0, 0, 0, 0.4)',
		divider: 'rgba(255, 255, 255, 0.14)',
		hashtag: '#f0e442',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.6)',
		// 成功 = 青 (青緑ではなく、エラーの朱と対になる青)
		success: '#56b4e9',
		// 赤紫 #CC79A7 (reddish purple)
		love: '#d98bb8',
		buttonBg: 'rgba(255, 255, 255, 0.08)',
		buttonHoverBg: 'rgba(255, 255, 255, 0.12)',
		switchBg: 'rgba(255, 255, 255, 0.15)',
		indicator: '@accent',
		// 橙 #E69F00 (orange)
		mentionMe: '#e69f00',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#f0e442',
		codeString: '#e69f00',
		fgOnAccent: '#16181d',
		fgOnWhite: '#1c1c1c',
		infoWarnBg: '#3d3100',
		infoWarnFg: '#f0e442',
		codeBoolean: '#d98bb8',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(255, 255, 255, 0.12)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#ffffff',
		panelHeaderBg: ':lighten<2<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':lighten<3<@panel',
		scrollbarHandle: 'rgba(255, 255, 255, 0.2)',
		inputBorderHover: 'rgba(255, 255, 255, 0.25)',
		scrollbarHandleHover: 'rgba(255, 255, 255, 0.4)',
		deckBg: '#101216',

		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		fgMuted: '#a9adb5',
		focusRing: '#f0e442',
		hairline: 'rgba(255, 255, 255, 0.1)',
		overlayDark: 'rgba(0, 0, 0, 0.6)',
		overlayLightbox: 'rgba(0, 0, 0, 0.85)',
		inlineCodeBg: '#2a2e36',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(0, 0, 0, 0.12)',
		'shadow-ambient': 'rgba(0, 0, 0, 0.25)',
		// 通知アイコンの塗り。7 種を Okabe-Ito の 7 色に 1:1 で割り当て (白アイコンが乗る)
		eventReaction: '#b57c00',
		eventReply: '#0072b2',
		eventRenote: '#009e73',
		eventFollow: '#2a8fc4',
		eventAchievement: '#8a7d00',
		eventLogin: '#a5578a',
		eventOther: '#6e737c',
		// 状態: オンライン = 青 / 離席 = 橙 / オフライン = 朱 (緑を使わない)
		statusOnline: '#56b4e9',
		statusActive: '#e69f00',
		statusOffline: '#f4883b',
		statusUnknown: '#8a8f98',
		modePolling: '#d98bb8',
		spotlight: '@warn',
		spotlightAlt: '#f7ef8f',
		replyHover: '#56b4e9',
		reactionHover: '#e69f00',
		codeEditorBg: '#16181d',
		codeEditorFg: '#e6e6e6',
		codeEditorFgMuted: '#a9adb5',
		codeEditorPanelBg: '#1f2228',
		codeEditorPanelBorder: '#3a3f48',
		codeEditorSelectionBg: '#1d4f70',
		codeEditorActiveItemBg: '#163d58',
		codeEditorCaret: '#e6e6e6',
		codeEditorGutterFg: '#8a8f98',
		codeEditorGutterActiveFg: '#e6e6e6',
		codeEditorActiveLineBg: 'rgba(255, 255, 255, 0.04)',
		codeEditorMatchBg: 'rgba(240, 228, 66, 0.2)',
		codeEditorMatchBorder: '#f0e442',
		codeKeyword: '#56b4e9',
		codeComment: '#a9adb5',
		codeVariable: '#e6e6e6',
		codeFunction: '#d98bb8',
		codeType: '#2fc695',
		codeLink: '#56b4e9',
		// 差分: 挿入 = 青 / 削除 = 朱
		diffInsertBg: 'rgba(86, 180, 233, 0.18)',
		diffInsertTextBg: 'rgba(86, 180, 233, 0.4)',
		diffDeleteBg: 'rgba(213, 94, 0, 0.2)',
		diffDeleteTextBg: 'rgba(213, 94, 0, 0.45)',
	},
}
