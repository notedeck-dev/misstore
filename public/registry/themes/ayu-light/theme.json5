{
	id: 'd83833a6-4838-43d3-8996-d8a10c742a8d',
	base: 'light',
	name: 'ayu Light',
	desc: 'ayu のライトフレーバー Light。白に近い背景にオレンジのアクセントと、ayu 特有の明るいシンタックスカラー。コード面まで公式パレットの色値を基に構成し、本文・リンク・コード色は WCAG AA を満たすよう明度を調整している',
	props: {
		// 色は ayu-colors の light (common / syntax / vcs / editor / ui) に従う。
		// ayu light の syntax 色は白地で 2〜3.6:1 しかないため、文字として使う色は色相・彩度を保って明度だけ下げた値 (元値をコメントで併記)
		bg: '#f8f9fa',
		fg: '#5c6166',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#1877bb',
		warn: '#a1650b',
		badge: '#267b98',
		error: '#e02828',
		focus: ':alpha<0.4<@accent',
		navBg: '#f8f9fa',
		navFg: '@fg',
		panel: '#fcfcfc',
		popup: '#ffffff',
		accent: '#ffaa33',
		header: ':alpha<0.7<@panel',
		infoBg: '#e3ecf8',
		infoFg: '@fg',
		renote: '#47802c',
		shadow: 'rgba(0, 0, 0, 0.1)',
		divider: 'rgba(107, 125, 143, 0.2)',
		hashtag: '#8f5dc1',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.4)',
		success: '#5c7b00',
		love: '#e31818',
		buttonBg: 'rgba(138, 145, 153, 0.12)',
		buttonHoverBg: 'rgba(138, 145, 153, 0.2)',
		switchBg: 'rgba(138, 145, 153, 0.3)',
		indicator: '@accent',
		mentionMe: '#be5305',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#8f5dc1',
		codeString: '#5c7b00',
		fgOnAccent: '#5c6166',
		fgOnWhite: '#5c6166',
		infoWarnBg: '#fcf0de',
		infoWarnFg: '#9e5c00',
		codeBoolean: '#8f5dc1',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(107, 125, 143, 0.25)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#2d3238',
		panelHeaderBg: ':darken<2<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':darken<3<@panel',
		scrollbarHandle: 'rgba(138, 145, 153, 0.35)',
		inputBorderHover: 'rgba(107, 125, 143, 0.5)',
		scrollbarHandleHover: 'rgba(138, 145, 153, 0.6)',
		deckBg: '#f3f4f5',

		// ---- NoteDeck 独自 ----
		accentText: '#a86200',
		fgMuted: '#6d757d',
		// フォーカスリングは accent (オレンジ) と区別できる entity 青 (調整値)
		focusRing: '#1877bb',
		hairline: 'rgba(107, 125, 143, 0.1)',
		overlayDark: 'rgba(0, 0, 0, 0.5)',
		overlayLightbox: 'rgba(0, 0, 0, 0.85)',
		inlineCodeBg: '#f3f4f5',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(0, 0, 0, 0.06)',
		'shadow-ambient': 'rgba(0, 0, 0, 0.1)',
		// 通知アイコンの塗り (白アイコンが乗る)
		eventReaction: '#a1650b',
		eventReply: '#1877bb',
		eventRenote: '#47802c',
		eventFollow: '#2e8166',
		eventAchievement: '#a86200',
		eventLogin: '#267b98',
		eventOther: '#8a9199',
		statusOnline: '#47802c',
		statusActive: '#a86200',
		statusOffline: '#e02828',
		statusUnknown: '#8a9199',
		modePolling: '#8f5dc1',
		spotlight: '@warn',
		spotlightAlt: '#e6ba7e',
		replyHover: '#1877bb',
		reactionHover: '#a86200',
		// コード面: 選択 = #035BD6 15% / 補完 = 8% を白地に合成した値。キャレットは accent の調整値
		codeEditorBg: '#fcfcfc',
		codeEditorFg: '#5c6166',
		codeEditorFgMuted: '#6d757d',
		codeEditorPanelBg: '#f3f4f5',
		codeEditorPanelBorder: 'rgba(107, 125, 143, 0.3)',
		codeEditorSelectionBg: '#d7e4f6',
		codeEditorActiveItemBg: '#e8eff9',
		codeEditorCaret: '#a86200',
		codeEditorGutterFg: '#6d757d',
		codeEditorGutterActiveFg: '#5c6166',
		codeEditorActiveLineBg: 'rgba(138, 145, 153, 0.1)',
		codeEditorMatchBg: 'rgba(159, 64, 255, 0.2)',
		codeEditorMatchBorder: '#8f5dc1',
		// トークン (元値): keyword #FA8D3E / string #86B300 / constant #A37ACC / func #F2AE49 / entity #399EE6 / tag #55B4D4 / comment #787B80 (そのまま)
		codeKeyword: '#be5305',
		codeComment: '#787b80',
		codeVariable: '#5c6166',
		codeFunction: '#a1650b',
		codeType: '#1877bb',
		codeLink: '#267b98',
		// 差分: vcs.added / vcs.removed
		diffInsertBg: 'rgba(108, 191, 67, 0.18)',
		diffInsertTextBg: 'rgba(108, 191, 67, 0.4)',
		diffDeleteBg: 'rgba(255, 115, 131, 0.18)',
		diffDeleteTextBg: 'rgba(255, 115, 131, 0.4)',
	},
}
