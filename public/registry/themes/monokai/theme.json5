		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#66d9ef',
		warn: '#e6db74',
		badge: '#fd971f',
		error: '#f92672',
		focus: ':alpha<0.3<@accent',
		navBg: '@panel',
		navFg: '#90908a',
		panel: '#272822',
		popup: '#3e3d32',
		accent: '#f92672',
		header: ':alpha<0.7<@panel',
		infoBg: '#3e3d32',
		infoFg: '@fg',
		renote: '#a6e22e',
		shadow: 'rgba(0, 0, 0, 0.3)',
		divider: '#414339',
		hashtag: '#a6e22e',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.5)',
		success: '#a6e22e',
		switchBg: 'rgba(255, 255, 255, 0.15)',
		indicator: '@accent',
		mentionMe: '@mention',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#ae81ff',
		codeString: '#e6db74',
		fgOnAccent: '#1e1f1c',
		fgOnWhite: '#272822',
		infoWarnBg: '#414339',
		infoWarnFg: '#e6db74',
		codeBoolean: '#ae81ff',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(255, 255, 255, 0.1)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#ffffff',
		panelHeaderBg: ':lighten<3<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':lighten<3<@panel',
		scrollbarHandle: 'rgba(255, 255, 255, 0.2)',
		inputBorderHover: 'rgba(255, 255, 255, 0.2)',
