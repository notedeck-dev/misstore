		codeEditorActiveLineBg: '#f2f0e5',
		codeEditorMatchBg: 'rgba(208, 162, 21, 0.3)',
		codeEditorMatchBorder: '#ad8301',
		// トークンの割り当ては独自: keyword = gr-700 / string = cy-700 / number = pu-600 / variable・link = bl-600 / function = or-600 / type = ye-700 / comment = tx-2
		codeKeyword: '#536907',
		codeComment: '#6f6e69',
		codeVariable: '#205ea6',
		codeFunction: '#bc5215',
		codeType: '#8e6b01',
		codeLink: '#205ea6',
		// 差分: gr-600 / re-600
		diffInsertBg: 'rgba(102, 128, 11, 0.15)',
		diffInsertTextBg: 'rgba(102, 128, 11, 0.35)',
		diffDeleteBg: 'rgba(175, 48, 41, 0.12)',
		diffDeleteTextBg: 'rgba(175, 48, 41, 0.3)',
	},
