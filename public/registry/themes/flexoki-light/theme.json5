{
	id: 'cc1a180f-0516-466e-9e3b-06f94e2ee878',
	base: 'light',
	name: 'Flexoki Light',
	desc: '紙とインクに着想を得たパレット Flexoki のライト。紙のような温かい白 (paper) の背景に彩度を抑えた 8 色のアクセント。コード面まで公式パレットの色値 (600〜700 段) を基に構成し、本文・リンク・コード色は WCAG AA 以上',
	props: {
		// 色は kepano/flexoki の base 階調 (paper / base-50 ...) とアクセント 600 段に従う。
		// 緑・青緑・黄の 600 段は paper 上で 3.4〜4.4:1 なので、文字として使う箇所は 1 段暗い 700 段
		bg: '#f2f0e5',
		fg: '#100f0f',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#205ea6',
		warn: '#8e6b01',
		badge: '#24837b',
		error: '#af3029',
		focus: ':alpha<0.4<@accent',
		navBg: '#f2f0e5',
		navFg: '@fg',
		panel: '#fffcf0',
		popup: '#fffcf0',
		accent: '#205ea6',
		header: ':alpha<0.7<@panel',
		infoBg: '#e1eceb',
		infoFg: '#163b66',
		renote: '#536907',
		shadow: 'rgba(16, 15, 15, 0.1)',
		divider: '#cecdc3',
		hashtag: '#8e6b01',
		mention: '@accent',
		modalBg: 'rgba(16, 15, 15, 0.4)',
		success: '#536907',
		love: '#a02f6f',
		buttonBg: '#e6e4d9',
		buttonHoverBg: '#dad8ce',
		switchBg: '#cecdc3',
		indicator: '@accent',
		mentionMe: '#bc5215',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#5e409d',
		codeString: '#1c6c66',
		fgOnAccent: '#fffcf0',
		fgOnWhite: '#100f0f',
		infoWarnBg: '#faeec6',
		infoWarnFg: '#664d01',
		codeBoolean: '#bc5215',
		dateLabelFg: '@fg',
		inputBorder: '#cecdc3',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#100f0f',
		panelHeaderBg: ':darken<2<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: '#f2f0e5',
		scrollbarHandle: 'rgba(16, 15, 15, 0.2)',
		inputBorderHover: '#b7b5ac',
		scrollbarHandleHover: 'rgba(16, 15, 15, 0.4)',
		deckBg: '#e6e4d9',

		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		fgMuted: '#6f6e69',
		// フォーカスリングは accent (青) と区別できる or-600
		focusRing: '#bc5215',
		hairline: '#e6e4d9',
		overlayDark: 'rgba(16, 15, 15, 0.5)',
		overlayLightbox: 'rgba(16, 15, 15, 0.85)',
		inlineCodeBg: '#e6e4d9',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(16, 15, 15, 0.06)',
		'shadow-ambient': 'rgba(16, 15, 15, 0.12)',
		// 通知アイコンの塗り (白アイコンが乗る)
		eventReaction: '#ad8301',
		eventReply: '#205ea6',
		eventRenote: '#66800b',
		eventFollow: '#24837b',
		eventAchievement: '#bc5215',
		eventLogin: '#5e409d',
		eventOther: '#878580',
		statusOnline: '#66800b',
		statusActive: '#ad8301',
		statusOffline: '#af3029',
		statusUnknown: '#878580',
		modePolling: '#5e409d',
		spotlight: '@warn',
		spotlightAlt: '#be9207',
		replyHover: '#205ea6',
		reactionHover: '#ad8301',
		// コード面: 面 = paper / パネル = base-50 / 選択 = bl-100 / 補完 = bl-50 / 検索 = ye-400
		codeEditorBg: '#fffcf0',
		codeEditorFg: '#100f0f',
		codeEditorFgMuted: '#6f6e69',
		codeEditorPanelBg: '#f2f0e5',
		codeEditorPanelBorder: '#cecdc3',
		codeEditorSelectionBg: '#c6dde8',
		codeEditorActiveItemBg: '#e1eceb',
