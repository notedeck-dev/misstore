		codeEditorGutterActiveFg: '#3b2f1e',
		codeEditorActiveLineBg: 'rgba(59, 47, 30, 0.05)',
		codeEditorMatchBg: 'rgba(168, 115, 26, 0.25)',
		codeEditorMatchBorder: '#a8731a',
		codeKeyword: '#7a4a1c',
		codeComment: '#6f5f48',
		codeVariable: '#3b2f1e',
