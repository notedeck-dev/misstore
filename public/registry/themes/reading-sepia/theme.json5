{
	id: '6cd2fd8d-7a8f-48a5-b650-a6cea4c53d9c',
	base: 'light',
	name: 'リーディングセピア',
	desc: '読書向けのセピア紙色ライト。明朝 / セリフの本文を 1 段大きくし、引用面・インラインコード・補助文字の濃さを長文向けに整える',
	props: {
		// セピアの紙。panel は少し明るい紙、deckBg は机の色
		bg: '#efe4cf',
		fg: '#3b2f1e',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#8a4b16',
		warn: '#7a5a00',
		badge: '@accent',
		error: '#9b2f2a',
		focus: ':alpha<0.3<@accent',
		navBg: '@panel',
		navFg: '@fg',
		panel: '#f7eedc',
		popup: '#f9f2e3',
		accent: '#8a5a2b',
		header: ':alpha<0.7<@panel',
		infoBg: '#e4dcc8',
		infoFg: '@fg',
		renote: '#2f6b5a',
		shadow: 'rgba(59, 47, 30, 0.1)',
		divider: 'rgba(59, 47, 30, 0.15)',
		hashtag: '#7a5a00',
		mention: '@accentText',
		modalBg: 'rgba(59, 47, 30, 0.45)',
		success: '#3f6b2a',
		love: '#9b3a5a',
		buttonBg: 'rgba(59, 47, 30, 0.06)',
		buttonHoverBg: 'rgba(59, 47, 30, 0.12)',
		switchBg: 'rgba(59, 47, 30, 0.18)',
		indicator: '@accent',
		mentionMe: '#8a3a1a',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.12<@accent',
		codeNumber: '#7a5a00',
		codeString: '#8a4b16',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#3b2f1e',
		infoWarnBg: '#f0dfae',
		infoWarnFg: '#5a4200',
		codeBoolean: '#7a4a7a',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(59, 47, 30, 0.2)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#2a2012',
		panelHeaderBg: ':darken<2<@panel',
		panelHeaderFg: '@fg',
		panelHighlight: ':darken<3<@panel',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		scrollbarHandle: 'rgba(59, 47, 30, 0.25)',
		inputBorderHover: 'rgba(59, 47, 30, 0.4)',
		scrollbarHandleHover: 'rgba(59, 47, 30, 0.45)',
		deckBg: '#e6d9c0',

		// ---- NoteDeck 独自 ----
		// 文字としての accent は塗りより濃くして紙の上で 4.5:1 以上
		accentText: '#7a4a1c',
		fgMuted: '#6f5f48',
		focusRing: '#8a4b16',
		hairline: 'rgba(59, 47, 30, 0.08)',
		overlayDark: 'rgba(40, 30, 15, 0.55)',
		overlayLightbox: 'rgba(30, 22, 10, 0.9)',
		inlineCodeBg: '#e8dcc2',
		inlineCodeFg: '#4a3a22',
		// MFM 引用の面
		'bg-secondary': 'rgba(59, 47, 30, 0.07)',
		'shadow-contact': 'rgba(59, 47, 30, 0.06)',
		'shadow-ambient': 'rgba(59, 47, 30, 0.12)',
		// 本文は明朝 / セリフ。本文サイズを 0.9em → 1em に 1 段上げる
		'font-sans': "'Hiragino Mincho ProN', 'Yu Mincho', YuMincho, 'BIZ UDMincho', 'Noto Serif JP', 'Noto Serif CJK JP', 'Iowan Old Style', Georgia, 'Times New Roman', serif",
		'font-body': '1em',
		// 通知アイコンの塗り (白アイコンが乗る)。紙に沈む落ち着いた色
		eventReaction: '#a8731a',
		eventReply: '#5a6f8a',
		eventRenote: '#3f7a5a',
		eventFollow: '#5a7a7a',
		eventAchievement: '#8a6a1a',
