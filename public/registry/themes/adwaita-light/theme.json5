		// バッジは塗りつぶしなので destructive_bg_color
		badge: '#e01b24',
		error: '#c30000',
		navBg: '#ebebed',
		navFg: 'rgba(0, 0, 6, 0.65)',
		panel: '#ffffff',
		popup: '#ffffff',
		focus: ':alpha<0.4<@accent',
		accent: '#3584e4',
		header: '#ffffff',
		infoBg: '#e8f1fc',
		renote: '#007c3d',
		shadow: 'rgba(0, 0, 6, 0.15)',
		infoFg: '@fg',
		divider: 'rgba(0, 0, 6, 0.07)',
		hashtag: '#9141ac',
		modalBg: 'rgba(0, 0, 6, 0.4)',
		success: '#007c3d',
		mention: '@accent',
		switchBg: 'rgba(0, 0, 6, 0.3)',
		fgOnWhite: 'rgba(0, 0, 6, 0.8)',
		indicator: '@accent',
		mentionMe: '@mention',
		messageBg: '@bg',
		navActive: '@accent',
		codeNumber: '#9141ac',
		codeString: '#26a269',
		fgOnAccent: '#ffffff',
		infoWarnBg: '#fdf3d9',
		infoWarnFg: '#905400',
		accentedBg: ':alpha<0.15<@accent',
		codeBoolean: '#c64600',
		inputBorder: 'rgba(0, 0, 6, 0.12)',
		panelBorder: '" solid 1px rgba(0, 0, 6, 0.07)',
		dateLabelFg: '@fg',
		navIndicator: '@indicator',
		fgHighlighted: '#000006',
		panelHeaderBg: '#ffffff',
		panelHeaderFg: '@fg',
		panelHighlight: '#f3f3f5',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		scrollbarHandle: 'rgba(0, 0, 6, 0.35)',
		inputBorderHover: 'rgba(0, 0, 6, 0.22)',
		scrollbarHandleHover: 'rgba(0, 0, 6, 0.55)',
		deckBg: '#ebebed',
