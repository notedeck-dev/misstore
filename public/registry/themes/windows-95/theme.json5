{
	id: '8bdcfaa5-3004-4e47-b832-8f69f5a949c8',
	base: 'light',
	name: 'Windows 95',
	desc: 'Windows 95 / 98 のシステムカラーを再現。シルバーの筐体に 3D ベベル、ネイビーのタイトルバー',
	props: {
		bg: '#c0c0c0',
		fg: '#000000',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#0000ff',
		warn: '#808000',
		badge: '#800000',
		error: '#800000',
		focus: 'rgba(0, 0, 128, 0.4)',
		navBg: '#c0c0c0',
		navFg: '#000000',
		panel: '#ffffff',
		popup: '#c0c0c0',
		accent: '#000080',
		header: '#c0c0c0',
		infoBg: '#ffffe1',
		infoFg: '#000000',
		renote: '#008000',
		shadow: 'rgba(0, 0, 0, 0.5)',
		divider: '#808080',
		hashtag: '#000080',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.5)',
		success: '#008000',
		switchBg: '#808080',
		indicator: '#800000',
		mentionMe: '@mention',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: 'rgba(0, 0, 128, 0.15)',
		codeNumber: '#800080',
		codeString: '#008000',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#000000',
		infoWarnBg: '#ffffe1',
		infoWarnFg: '#800000',
		codeBoolean: '#000080',
		dateLabelFg: '@fg',
		inputBorder: '#808080',
		// `"` 始まりの値は色として解釈されず生 CSS として出力される。
		// Win95 の凸ベベル (上/左ハイライト・下/右シャドウ) は border-style: outset で再現できる。
		panelBorder: '" 2px outset #c0c0c0',
		navIndicator: '@indicator',
		fgHighlighted: '#000000',
		// アクティブタイトルバー: ActiveTitle #000080 → GradientActiveTitle #1084d0
		panelHeaderBg: '" linear-gradient(90deg, #000080, #1084d0)',
		panelHeaderFg: '#ffffff',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '#c0c0c0',
		panelHighlight: '#dfdfdf',
		scrollbarHandle: '#808080',
		inputBorderHover: '#000000',
		scrollbarHandleHover: '#000000',
		// Win95 のデスクトップ既定色 (Teal)
		deckBg: '#008080',
	},
}
