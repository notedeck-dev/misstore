{
	id: 'dff16ee0-182d-4f89-9ee5-efacd8dc501c',
	base: 'light',
	name: 'CUD ライト',
	desc: '色覚多様性 (CUD) 向けのライト。Okabe-Ito パレットで赤緑の対立を青と朱に置き換え、成功 = 青 / エラー = 朱、挿入 = 青 / 削除 = 朱。本文は WCAG AA 以上',
	props: {
		// 大面積は無彩色。色の判別は Okabe-Ito の 7 色だけに任せる
		bg: '#f2f3f5',
		fg: '#1c1c1c',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		// 青 #0072B2 (Okabe-Ito blue)
		link: '#0072b2',
		// 橙 #E69F00 を白地で読めるよう暗くしたもの (黄は白地で読めないため橙系で代替)
		warn: '#8a5f00',
		badge: '@accent',
		// 朱 #D55E00 (vermilion) を白地で読めるよう暗くしたもの
		error: '#b84e00',
		focus: ':alpha<0.3<@accent',
		navBg: '@panel',
		navFg: '@fg',
		panel: '#ffffff',
		popup: '#ffffff',
		accent: '#0072b2',
		header: ':alpha<0.7<@panel',
		infoBg: '#dcefff',
		infoFg: '#1c1c1c',
		// 青緑 #009E73 (bluish green) を白地向けに暗くしたもの
		renote: '#007a58',
		shadow: 'rgba(0, 0, 0, 0.1)',
		divider: 'rgba(0, 0, 0, 0.12)',
		hashtag: '#8a5f00',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.4)',
		// 成功 = 青 (青緑ではなく、エラーの朱と対になる青)
		success: '#0072b2',
		// 赤紫 #CC79A7 (reddish purple) を白地向けに暗くしたもの
		love: '#a3487f',
		buttonBg: 'rgba(0, 0, 0, 0.05)',
		buttonHoverBg: 'rgba(0, 0, 0, 0.1)',
		switchBg: 'rgba(0, 0, 0, 0.15)',
		indicator: '@accent',
		mentionMe: '#a3487f',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.12<@accent',
		codeNumber: '#8a5f00',
		codeString: '#b84e00',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#1c1c1c',
		infoWarnBg: '#fff1cc',
		infoWarnFg: '#6b4a00',
		codeBoolean: '#a3487f',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(0, 0, 0, 0.15)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#000000',
		panelHeaderBg: ':darken<2<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':darken<3<@panel',
		scrollbarHandle: 'rgba(0, 0, 0, 0.2)',
		inputBorderHover: 'rgba(0, 0, 0, 0.3)',
		scrollbarHandleHover: 'rgba(0, 0, 0, 0.4)',
		deckBg: '#e6e8ec',

		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		fgMuted: '#5a5f68',
		// フォーカスリングは朱。青の accent 塗りの上でも見える
		focusRing: '#b84e00',
		hairline: 'rgba(0, 0, 0, 0.08)',
		overlayDark: 'rgba(0, 0, 0, 0.5)',
		overlayLightbox: 'rgba(0, 0, 0, 0.85)',
		inlineCodeBg: '#e9eaee',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(0, 0, 0, 0.06)',
		'shadow-ambient': 'rgba(0, 0, 0, 0.12)',
		// 通知アイコンの塗り。7 種を Okabe-Ito の 7 色に 1:1 で割り当て (白アイコンが乗る)
		eventReaction: '#b57c00',
		eventReply: '#0072b2',
		eventRenote: '#007a58',
		eventFollow: '#2a8fc4',
		eventAchievement: '#8a7d00',
		eventLogin: '#a5578a',
		eventOther: '#6b7079',
		// 状態: オンライン = 青 / 離席 = 橙 / オフライン = 朱 (緑を使わない)
		statusOnline: '#0072b2',
		statusActive: '#b57c00',
		statusOffline: '#d55e00',
		statusUnknown: '#8a8f98',
		modePolling: '#a3487f',
		spotlight: '@warn',
		spotlightAlt: '#c48a00',
		replyHover: '#0072b2',
		reactionHover: '#b57c00',
		codeEditorBg: '#ffffff',
		codeEditorFg: '#1c1c1c',
		codeEditorFgMuted: '#5a5f68',
		codeEditorPanelBg: '#f2f3f5',
		codeEditorPanelBorder: '#d0d3d8',
		codeEditorSelectionBg: '#bfe0f5',
		codeEditorActiveItemBg: '#d6ecf9',
		codeEditorCaret: '#1c1c1c',
		codeEditorGutterFg: '#656a73',
		codeEditorGutterActiveFg: '#1c1c1c',
		codeEditorActiveLineBg: 'rgba(0, 0, 0, 0.04)',
		codeEditorMatchBg: 'rgba(230, 159, 0, 0.25)',
		codeEditorMatchBorder: '#b57c00',
		codeKeyword: '#0072b2',
		codeComment: '#5a5f68',
		codeVariable: '#1c1c1c',
		codeFunction: '#a3487f',
		codeType: '#007a58',
		codeLink: '#0072b2',
		// 差分: 挿入 = 青 / 削除 = 朱
		diffInsertBg: 'rgba(0, 114, 178, 0.14)',
		diffInsertTextBg: 'rgba(0, 114, 178, 0.32)',
		diffDeleteBg: 'rgba(213, 94, 0, 0.14)',
		diffDeleteTextBg: 'rgba(213, 94, 0, 0.35)',
	},
}
