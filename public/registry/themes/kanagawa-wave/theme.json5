{
	id: '105ae6fe-1953-484d-a5bb-2fb9cbf39629',
	base: 'dark',
	name: 'Kanagawa Wave',
	desc: '葛飾北斎『神奈川沖浪裏』の色を基にした Neovim テーマ Kanagawa の既定フレーバー Wave。墨色 (sumiInk) の背景に藍・紫・薄黄のやわらかなアクセント。エディタ由来のパレットなので、NoteDeck のコードエディタ・コードブロック・差分表示の色まで公式パレットの色値を基に構成している',
	props: {
		// パレット名は kanagawa.nvim の lua/kanagawa/colors.lua に従う (sumiInk / fujiWhite / crystalBlue ...)
		bg: '#1f1f28',
		fg: '#dcd7ba',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#7fb4ca',
		warn: '#ff9e3b',
		badge: '#e46876',
		error: '#ff5d62',
		focus: ':alpha<0.4<@accent',
		navBg: '#181820',
		navFg: '@fg',
		panel: '#2a2a37',
		popup: '#363646',
		accent: '#7e9cd8',
		header: ':alpha<0.7<@panel',
		infoBg: '#223249',
		infoFg: '#dcd7ba',
		renote: '#98bb6c',
		shadow: 'rgba(0, 0, 0, 0.3)',
		divider: 'rgba(84, 84, 109, 0.5)',
		hashtag: '#e6c384',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.5)',
		success: '#98bb6c',
		love: '#d27e99',
		buttonBg: '#363646',
		buttonHoverBg: ':lighten<5<@buttonBg',
		switchBg: '#54546d',
		indicator: '@accent',
		mentionMe: '#ffa066',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#d27e99',
		codeString: '#98bb6c',
		fgOnAccent: '#1f1f28',
		fgOnWhite: '#1f1f28',
		infoWarnBg: '#49443c',
		infoWarnFg: '#e6c384',
		codeBoolean: '#ffa066',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(220, 215, 186, 0.1)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: ':lighten<8<@fg',
		panelHeaderBg: ':lighten<3<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':lighten<3<@panel',
		scrollbarHandle: 'rgba(220, 215, 186, 0.2)',
		inputBorderHover: 'rgba(220, 215, 186, 0.2)',
		scrollbarHandleHover: 'rgba(220, 215, 186, 0.4)',
		deckBg: '#16161d',

		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		fgMuted: '#c8c093',
		// フォーカスリングは accent (crystalBlue) と区別できる surimiOrange
		focusRing: '#ffa066',
		hairline: 'rgba(220, 215, 186, 0.08)',
		overlayDark: 'rgba(0, 0, 0, 0.6)',
		overlayLightbox: 'rgba(0, 0, 0, 0.85)',
		inlineCodeBg: '#16161d',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(0, 0, 0, 0.25)',
		'shadow-ambient': 'rgba(0, 0, 0, 0.4)',
		// 通知アイコンの塗り (白アイコンが乗る)
		eventReaction: '#dca561',
		eventReply: '#7e9cd8',
		eventRenote: '#76946a',
		eventFollow: '#7aa89f',
		eventAchievement: '#c0a36e',
		eventLogin: '#7fb4ca',
		eventOther: '#938aa9',
		statusOnline: '#98bb6c',
		statusActive: '#ff9e3b',
		statusOffline: '#ff5d62',
		statusUnknown: '#717c7c',
		modePolling: '#b8b4d0',
		spotlight: '@warn',
		spotlightAlt: '#e6c384',
		replyHover: '#7fb4ca',
		reactionHover: '#e6c384',
		// コード面: 面 = sumiInk3 / float = sumiInk0 / 選択 = waveBlue1 / 検索 = waveBlue2 / カーソル行番号 = roninYellow
		codeEditorBg: '#1f1f28',
		codeEditorFg: '#dcd7ba',
		codeEditorFgMuted: '#c8c093',
		codeEditorPanelBg: '#16161d',
