		codeEditorMatchBg: 'rgba(45, 79, 103, 0.7)',
		codeEditorMatchBorder: '#7fb4ca',
		// トークン: statement = oniViolet / string = springGreen / number = sakuraPink / identifier = carpYellow / fun = crystalBlue / type = waveAqua2 / special = springBlue
		codeKeyword: '#957fb8',
		codeComment: '#727169',
		codeVariable: '#e6c384',
		codeFunction: '#7e9cd8',
		codeType: '#7aa89f',
		codeLink: '#7fb4ca',
		// 差分: 行は winterGreen / winterRed、語は autumnGreen / autumnRed
		diffInsertBg: '#2b3328',
		diffInsertTextBg: 'rgba(118, 148, 106, 0.45)',
		diffDeleteBg: '#43242b',
		diffDeleteTextBg: 'rgba(195, 64, 67, 0.45)',
	},
