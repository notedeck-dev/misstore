		navFg: 'rgba(255, 255, 255, 0.79)',
		panel: '#2b2b2b',
		popup: '#2c2c2c',
		focus: ':alpha<0.4<@accent',
		accent: '#60cdff',
		header: ':alpha<0.7<@panel',
		infoBg: '#2a2a2a',
		renote: '#6ccb5f',
		shadow: 'rgba(0, 0, 0, 0.5)',
		infoFg: '@fg',
		divider: 'rgba(255, 255, 255, 0.08)',
		hashtag: '#b4a0ff',
		modalBg: 'rgba(0, 0, 0, 0.55)',
		success: '#6ccb5f',
		mention: '@accent',
		switchBg: 'rgba(255, 255, 255, 0.55)',
		fgOnWhite: '#1b1b1b',
		indicator: '@accent',
		mentionMe: '@mention',
		messageBg: '@bg',
		navActive: '@accent',
		codeNumber: '#b5cea8',
		codeString: '#ce9178',
		// Windows 11 のアクセントボタンはダークでも文字が黒
		fgOnAccent: '#000000',
		infoWarnBg: '#433519',
		infoWarnFg: '#fce100',
		accentedBg: ':alpha<0.15<@accent',
		codeBoolean: '#569cd6',
		inputBorder: 'rgba(255, 255, 255, 0.1)',
		panelBorder: '" solid 1px rgba(255, 255, 255, 0.08)',
		dateLabelFg: '@fg',
		navIndicator: '@indicator',
		fgHighlighted: '#ffffff',
		panelHeaderBg: '#2f2f2f',
		panelHeaderFg: '@fg',
		panelHighlight: '#323232',
