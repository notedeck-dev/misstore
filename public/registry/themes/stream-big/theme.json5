		'font-lg': '1.25em',
		'font-xl': '1.4em',
		'font-2xl': '1.75em',
		'weight-regular': '500',
		// カラム間と余白を広げ、画面越しでも区切りが分かるようにする
		columnGap: '12px',
		margin: '16px',
		// 通知アイコンの塗りは鮮やかに (白アイコンが乗る)
		eventReaction: '#cf7c12',
		eventReply: '#2f7fe8',
		eventRenote: '#17a06c',
		eventFollow: '#1ea0c9',
