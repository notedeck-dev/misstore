{
	id: 'eba50013-dd60-4c09-89dd-8697b62c708e',
	base: 'dark',
	name: 'ストリーム ビッグ',
	desc: '配信 / プレゼン向け。無難なダークに文字を 1 段大きく・太くし、カラム間と余白を広げ、通知色とオンライン表示を鮮やかにする',
	props: {
		// 配信画面で潰れない、やや青みのニュートラルなダーク
		bg: '#1b1d22',
		fg: '#eceef2',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#8ab4ff',
		warn: '#f5c04a',
		badge: '@accent',
		error: '#ff6b6b',
		focus: ':alpha<0.3<@accent',
		navBg: '#171a1f',
		navFg: '@fg',
		panel: '#24272e',
		popup: '#2c3038',
		accent: '#3870d4',
		header: ':alpha<0.7<@panel',
		infoBg: '#253244',
		infoFg: '@fg',
		renote: '#3ec9a7',
		shadow: 'rgba(0, 0, 0, 0.3)',
		divider: 'rgba(255, 255, 255, 0.14)',
		hashtag: '#ffb86b',
		mention: '@accentText',
		modalBg: 'rgba(0, 0, 0, 0.55)',
		success: '#4fd1a0',
		love: '#ff6f9c',
		buttonBg: 'rgba(255, 255, 255, 0.08)',
		buttonHoverBg: 'rgba(255, 255, 255, 0.14)',
		switchBg: 'rgba(255, 255, 255, 0.15)',
		indicator: '@accent',
		mentionMe: '#f5c04a',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.18<@accent',
		codeNumber: '#c3e88d',
		codeString: '#ffb86b',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#1b1d22',
		infoWarnBg: '#3d3014',
		infoWarnFg: '#f5c04a',
		codeBoolean: '#c084fc',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(255, 255, 255, 0.12)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#ffffff',
		panelHeaderBg: ':lighten<2<@panel',
		panelHeaderFg: '@fg',
		panelHighlight: ':lighten<3<@panel',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		scrollbarHandle: 'rgba(255, 255, 255, 0.2)',
		inputBorderHover: 'rgba(255, 255, 255, 0.24)',
		scrollbarHandleHover: 'rgba(255, 255, 255, 0.4)',
		deckBg: '#13151a',

		// ---- NoteDeck 独自 ----
		accentText: '#8ab4ff',
		fgMuted: '#a3a9b5',
		focusRing: '#f5c04a',
		hairline: 'rgba(255, 255, 255, 0.08)',
		overlayDark: 'rgba(0, 0, 0, 0.65)',
		overlayLightbox: 'rgba(0, 0, 0, 0.9)',
		inlineCodeBg: '#2c3038',
		inlineCodeFg: '@fg',
		'bg-secondary': 'rgba(255, 255, 255, 0.06)',
		'shadow-contact': 'rgba(0, 0, 0, 0.2)',
		'shadow-ambient': 'rgba(0, 0, 0, 0.35)',
		// 文字を 1 段大きく (約 1.15 倍) し、通常ウェイトを 500 に。配信の縮小表示でも読める
		'font-2xs': '0.8em',
		'font-xs': '0.85em',
		'font-sm': '0.9em',
		'font-md': '0.95em',
