		fg: '#000000',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#0b3d91',
		warn: '#7a4f00',
		badge: '@accent',
		error: '#a80000',
		focus: ':alpha<0.4<@accent',
