		scrollbarHandleHover: 'rgba(0, 0, 0, 0.8)',
		deckBg: '#e0e0e0',

		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		accentDarken: '#072b68',
		fgMuted: '#3a3a3a',
		// フォーカスリングは accent と区別できる濃いマゼンタ。白・黒・accent のどの面でも見える
