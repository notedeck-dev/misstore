		mentionMe: '#6a1b9a',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#005c3c',
		codeString: '#8a2b00',
		fgOnAccent: '#ffffff',
		fgOnWhite: '#000000',
		infoWarnBg: '#fff0c2',
