		navFg: '@fg',
		panel: '#ffffff',
		popup: '#ffffff',
		accent: '#0b3d91',
		header: '@panel',
		infoBg: '#dcebff',
		infoFg: '#000000',
		renote: '#075a26',
		shadow: 'rgba(0, 0, 0, 0.3)',
		// 区切り線は半透明にせず、不透明な濃いグレー
