{
	id: 'ff445e35-8641-4393-a2d1-1dcbdbc51465',
	base: 'dark',
	name: 'ayu Mirage',
	desc: 'ayu の中間フレーバー Mirage。青みがかった暗灰の背景にやわらかな黄のアクセント。エディタ由来のパレットなので、NoteDeck のコードエディタ・コードブロック・差分表示の色まで公式パレットの色値を基に構成している',
	props: {
		// 色は ayu-colors の mirage (common / syntax / vcs / editor / ui) に従う
		bg: '#1f2430',
		fg: '#cccac2',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#73d0ff',
		warn: '#ffd173',
		badge: '#5ccfe6',
		error: '#ff6666',
		focus: ':alpha<0.4<@accent',
		navBg: '#1c212b',
		navFg: '@fg',
		panel: '#242936',
		popup: ':lighten<3<@panel',
		accent: '#ffcc66',
		header: ':alpha<0.7<@panel',
		infoBg: '#283b54',
		infoFg: '@fg',
		renote: '#87d96c',
		shadow: 'rgba(18, 21, 28, 0.7)',
		divider: 'rgba(112, 122, 140, 0.4)',
		hashtag: '#dfbfff',
		mention: '@accent',
		modalBg: 'rgba(18, 21, 28, 0.6)',
		success: '#d5ff80',
		love: '#f28779',
		buttonBg: 'rgba(112, 122, 140, 0.25)',
		buttonHoverBg: 'rgba(112, 122, 140, 0.4)',
		switchBg: 'rgba(112, 122, 140, 0.45)',
		indicator: '@accent',
		mentionMe: '#ffad66',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#dfbfff',
		codeString: '#d5ff80',
		fgOnAccent: '#1f2430',
		fgOnWhite: '#1f2430',
		infoWarnBg: '#45423d',
		infoWarnFg: '#ffcc66',
		codeBoolean: '#dfbfff',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(112, 122, 140, 0.4)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: ':lighten<10<@fg',
		panelHeaderBg: ':lighten<2<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':lighten<3<@panel',
		scrollbarHandle: 'rgba(112, 122, 140, 0.4)',
		inputBorderHover: 'rgba(112, 122, 140, 0.7)',
		scrollbarHandleHover: 'rgba(112, 122, 140, 0.7)',
		deckBg: '#1c212b',

		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		fgMuted: '#8a9199',
		// フォーカスリングは accent (黄) と区別できる entity 青
		focusRing: '#73d0ff',
		hairline: 'rgba(112, 122, 140, 0.25)',
		overlayDark: 'rgba(18, 21, 28, 0.7)',
		overlayLightbox: 'rgba(18, 21, 28, 0.9)',
		inlineCodeBg: '#1c212b',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(18, 21, 28, 0.4)',
		'shadow-ambient': 'rgba(18, 21, 28, 0.7)',
		// 通知アイコンの塗り (白アイコンが乗る)
		eventReaction: '#ffcc66',
		eventReply: '#73d0ff',
		eventRenote: '#87d96c',
		eventFollow: '#95e6cb',
		eventAchievement: '#ffd173',
		eventLogin: '#5ccfe6',
		eventOther: '#707a8c',
		statusOnline: '#87d96c',
		statusActive: '#ffcc66',
		statusOffline: '#ff6666',
		statusUnknown: '#707a8c',
		modePolling: '#dfbfff',
		spotlight: '@warn',
		spotlightAlt: '#ffdfb3',
		replyHover: '#73d0ff',
		reactionHover: '#ffcc66',
		// コード面: 選択 = #409FFF 25% / 補完 = 15% を面の上に合成した値。コメントは #B8CFE6 50% を合成
		codeEditorBg: '#242936',
		codeEditorFg: '#cccac2',
		codeEditorFgMuted: '#8a9199',
		codeEditorPanelBg: '#1c212b',
		codeEditorPanelBorder: 'rgba(112, 122, 140, 0.45)',
		codeEditorSelectionBg: '#2b4768',
		codeEditorActiveItemBg: '#283b54',
		codeEditorCaret: '#ffcc66',
		codeEditorGutterFg: '#8a9199',
		codeEditorGutterActiveFg: '#cccac2',
		codeEditorActiveLineBg: '#1a1f29',
		codeEditorMatchBg: 'rgba(105, 83, 128, 0.6)',
		codeEditorMatchBorder: '#695380',
		// トークン: keyword / string / constant / func / entity / tag は ayu-colors の syntax、変数は fg
		codeKeyword: '#ffad66',
		codeComment: '#6e7c8e',
		codeVariable: '#cccac2',
		codeFunction: '#ffd173',
		codeType: '#73d0ff',
		codeLink: '#5ccfe6',
		// 差分: vcs.added / vcs.removed
		diffInsertBg: 'rgba(135, 217, 108, 0.15)',
		diffInsertTextBg: 'rgba(135, 217, 108, 0.35)',
		diffDeleteBg: 'rgba(242, 121, 131, 0.15)',
		diffDeleteTextBg: 'rgba(242, 121, 131, 0.35)',
	},
}
