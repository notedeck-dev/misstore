{
	id: 'c4b039c5-7136-4435-aad3-cac8338ae794',
	base: 'dark',
	name: 'OLED ブラック',
	desc: 'OLED 向けの純黒。bg / panel / deckBg / navBg / コード面まで #000 で、影は透明。面の区切りは hairline と divider だけに任せる。ブランド色は使わない',
	props: {
		// 大面積はすべて純黒。panel と bg の差は付けず、線だけで区切る
		bg: '#000000',
		fg: '#e6e6e6',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#6cb6ff',
		warn: '#f0c040',
		badge: '@accent',
		error: '#ff6b6b',
		focus: ':alpha<0.3<@accent',
		navBg: '#000000',
		navFg: '@fg',
		panel: '#000000',
		popup: '#0a0a0a',
		accent: '#4d9fe6',
		header: ':alpha<0.85<@panel',
		infoBg: '#0b1a26',
		infoFg: '@fg',
		renote: '#4cc9a0',
		// 純黒の上では影が見えないので全部透明
		shadow: 'rgba(0, 0, 0, 0)',
		// 面同士の唯一の区切り。黒の上で見えるよう通常より濃くする
		divider: 'rgba(255, 255, 255, 0.3)',
		hashtag: '#f0c040',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.7)',
		success: '#5ad17a',
		love: '#ff7a9e',
		buttonBg: 'rgba(255, 255, 255, 0.08)',
		buttonHoverBg: 'rgba(255, 255, 255, 0.14)',
		switchBg: 'rgba(255, 255, 255, 0.15)',
		indicator: '@accent',
		mentionMe: '#f0c040',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.18<@accent',
		codeNumber: '#c3e88d',
		codeString: '#f0a860',
		fgOnAccent: '#000000',
		fgOnWhite: '#000000',
		infoWarnBg: '#261d00',
		infoWarnFg: '#f0c040',
		codeBoolean: '#c79bff',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(255, 255, 255, 0.18)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#ffffff',
		panelHeaderBg: '@panel',
		panelHeaderFg: '@fg',
		panelHighlight: '#0d0d0d',
		windowHeader: '#000000',
		folderHeaderBg: 'rgba(255, 255, 255, 0.05)',
		folderHeaderHoverBg: 'rgba(255, 255, 255, 0.1)',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		scrollbarHandle: 'rgba(255, 255, 255, 0.25)',
		inputBorderHover: 'rgba(255, 255, 255, 0.35)',
		scrollbarHandleHover: 'rgba(255, 255, 255, 0.45)',
		deckBg: '#000000',

		// ---- NoteDeck 独自 ----
		accentText: '#6cb6ff',
		fgMuted: '#9a9a9a',
		// フォーカスリングは accent (青) と区別できる黄
		focusRing: '#f0c040',
		hairline: 'rgba(255, 255, 255, 0.18)',
		overlayDark: 'rgba(0, 0, 0, 0.7)',
		// ライトボックスは完全な黒で OLED を消灯させる
