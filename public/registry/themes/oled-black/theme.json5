		'shadow-ambient': 'rgba(0, 0, 0, 0)',
		// 通知アイコンの塗り (白アイコンが乗る)。黒地で 3:1 以上
		eventReaction: '#b8780f',
		eventReply: '#2d7fd6',
		eventRenote: '#1f9a66',
		eventFollow: '#1f8fa8',
		eventAchievement: '#a68a10',
		eventLogin: '#2d7fd6',
		eventOther: '#6e737a',
