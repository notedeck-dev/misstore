{
	id: '7ff5e006-0e21-4a7c-9298-93e3f0ba62e6',
	base: 'dark',
	name: 'ayu Dark',
	desc: 'ayu の最もダークなフレーバー Dark。ほぼ黒の背景に琥珀色のアクセントと、オレンジ・緑・青のシンタックスカラー。エディタ由来のパレットなので、NoteDeck のコードエディタ・コードブロック・差分表示の色まで公式パレットの色値を基に構成している',
	props: {
		// 色は ayu-colors の dark (common / syntax / vcs / editor / ui) に従う
		bg: '#0b0e14',
		fg: '#bfbdb6',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
