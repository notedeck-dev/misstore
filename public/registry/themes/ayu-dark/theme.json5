		// ---- NoteDeck 独自 ----
		accentText: '@accent',
		fgMuted: '#8a9199',
		// フォーカスリングは accent (琥珀) と区別できる entity 青
		focusRing: '#59c2ff',
		hairline: 'rgba(86, 91, 102, 0.3)',
		overlayDark: 'rgba(0, 0, 0, 0.7)',
