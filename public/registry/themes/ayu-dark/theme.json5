		navBg: '#0d1017',
		navFg: '@fg',
		panel: '#0f131a',
		popup: '#131721',
		accent: '#e6b450',
		header: ':alpha<0.7<@panel',
		infoBg: '#16283c',
		infoFg: '@fg',
		renote: '#7fd962',
		shadow: 'rgba(0, 0, 0, 0.5)',
