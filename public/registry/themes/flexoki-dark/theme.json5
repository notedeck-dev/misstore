{
	id: '8f8a1a97-6499-469f-8767-72e5fc2f5446',
	base: 'dark',
	name: 'Flexoki Dark',
	desc: 'Steph Ango (kepano) による、紙とインクに着想を得たパレット Flexoki のダーク。墨のような黒の背景に彩度を抑えた 8 色のアクセント (ダークは 400 段)。コードエディタ・コードブロック・差分表示の色まで公式パレットの色値を基に構成している',
	props: {
		// 色は kepano/flexoki の base 階調 (black / base-950 ...) とアクセント 400 段に従う。
		// アクセント青 (bl-400 #4385BE) は panel 上で 4.4:1 なので、文字として使う link / accentText は 1 段明るい bl-300
		bg: '#100f0f',
		fg: '#cecdc3',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#66a0c8',
		warn: '#d0a215',
		badge: '#3aa99f',
		error: '#e8705f',
		focus: ':alpha<0.4<@accent',
		navBg: '#100f0f',
		navFg: '@fg',
		panel: '#1c1b1a',
		popup: '#282726',
		accent: '#4385be',
		header: ':alpha<0.7<@panel',
		infoBg: '#12253b',
		infoFg: '#c6dde8',
		renote: '#879a39',
		shadow: 'rgba(0, 0, 0, 0.4)',
		divider: '#403e3c',
		hashtag: '#d0a215',
		mention: '@accent',
		modalBg: 'rgba(0, 0, 0, 0.6)',
		success: '#879a39',
		love: '#ce5d97',
		buttonBg: '#282726',
		buttonHoverBg: '#343331',
		switchBg: '#403e3c',
		indicator: '@accent',
		mentionMe: '#da702c',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#8b7ec8',
		codeString: '#3aa99f',
		fgOnAccent: '#fffcf0',
		fgOnWhite: '#100f0f',
		infoWarnBg: '#3a2d04',
		infoWarnFg: '#eccb60',
		codeBoolean: '#da702c',
		dateLabelFg: '@fg',
		inputBorder: '#403e3c',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#fffcf0',
		panelHeaderBg: ':lighten<3<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: '#282726',
		scrollbarHandle: 'rgba(206, 205, 195, 0.2)',
		inputBorderHover: '#575653',
		scrollbarHandleHover: 'rgba(206, 205, 195, 0.4)',
		deckBg: ':darken<3<@bg',

		// ---- NoteDeck 独自 ----
		accentText: '#66a0c8',
		fgMuted: '#878580',
		// フォーカスリングは accent (青) と区別できる ye-400
		focusRing: '#d0a215',
		hairline: '#282726',
		overlayDark: 'rgba(16, 15, 15, 0.7)',
		overlayLightbox: 'rgba(16, 15, 15, 0.9)',
		inlineCodeBg: '#282726',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(0, 0, 0, 0.3)',
		'shadow-ambient': 'rgba(0, 0, 0, 0.5)',
		// 通知アイコンの塗り (白アイコンが乗る)
		eventReaction: '#be9207',
		eventReply: '#3171b2',
		eventRenote: '#768d21',
		eventFollow: '#2f968d',
		eventAchievement: '#cb6120',
		eventLogin: '#735eb5',
		eventOther: '#6f6e69',
		statusOnline: '#879a39',
		statusActive: '#d0a215',
		statusOffline: '#d14d41',
		statusUnknown: '#878580',
		modePolling: '#8b7ec8',
		spotlight: '@warn',
		spotlightAlt: '#eccb60',
		replyHover: '#4385be',
		reactionHover: '#d0a215',
		// コード面: 面 = black / パネル = base-950 / 選択 = bl-850 / 補完 = bl-900 / 検索 = ye-400
		codeEditorBg: '#100f0f',
		codeEditorFg: '#cecdc3',
		codeEditorFgMuted: '#878580',
		codeEditorPanelBg: '#1c1b1a',
		codeEditorPanelBorder: '#403e3c',
		codeEditorSelectionBg: '#133051',
		codeEditorActiveItemBg: '#12253b',
		codeEditorCaret: '#cecdc3',
		codeEditorGutterFg: '#878580',
		codeEditorGutterActiveFg: '#cecdc3',
		codeEditorActiveLineBg: '#1c1b1a',
		codeEditorMatchBg: 'rgba(208, 162, 21, 0.25)',
		codeEditorMatchBorder: '#d0a215',
		// トークンの割り当ては独自: keyword = gr / string = cy / number = pu / variable・link = bl / function = or / type = ye / comment = tx-2
		codeKeyword: '#879a39',
		codeComment: '#878580',
		codeVariable: '#4385be',
		codeFunction: '#da702c',
		codeType: '#d0a215',
		codeLink: '#4385be',
		// 差分: gr-400 / re-400
		diffInsertBg: 'rgba(135, 154, 57, 0.18)',
		diffInsertTextBg: 'rgba(135, 154, 57, 0.4)',
		diffDeleteBg: 'rgba(209, 77, 65, 0.18)',
		diffDeleteTextBg: 'rgba(209, 77, 65, 0.4)',
	},
}
