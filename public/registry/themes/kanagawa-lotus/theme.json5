{
	id: '1b7b2460-6a9c-44c4-9cf8-abb426e99944',
	base: 'light',
	name: 'Kanagawa Lotus',
	desc: 'Kanagawa のライトフレーバー Lotus。生成りの和紙のような背景 (lotusWhite) に紫・藍・緑のアクセント。コード面まで公式パレットの色値を基に構成し、本文・リンク・コード色は WCAG AA を満たすよう明度を調整している',
	props: {
		// パレット名は kanagawa.nvim の lua/kanagawa/colors.lua に従う (lotusWhite / lotusInk / lotusBlue ...)。
		// 文字として使う緑・桃・黄・青緑・水色は公式値では紙地で AA に届かないため明度を 5〜15% 下げている
		bg: '#e5ddb0',
		fg: '#545464',
		X10: ':alpha<0.4<@accent',
		X14: ':alpha<0.5<@navBg',
		X15: ':alpha<0<@panel',
		X16: ':alpha<0.7<@panel',
		X17: ':alpha<0.8<@bg',
		link: '#5d57a3',
		warn: '#9e5400',
		badge: '#d7474b',
		error: '#bd3649',
		focus: ':alpha<0.4<@accent',
		navBg: '#dcd5ac',
		navFg: '@fg',
		panel: '#f2ecbc',
		popup: '#f2ecbc',
		accent: '#4d699b',
		header: ':alpha<0.7<@panel',
		infoBg: '#c7d7e0',
		infoFg: '#43436c',
		renote: '#5a6f3f',
		shadow: 'rgba(84, 84, 100, 0.15)',
		divider: 'rgba(113, 110, 97, 0.35)',
		hashtag: '#9e5400',
		mention: '@accent',
		modalBg: 'rgba(84, 84, 100, 0.4)',
		success: '#5a6f3f',
		love: '#a44c6a',
		buttonBg: 'rgba(84, 84, 100, 0.08)',
		buttonHoverBg: 'rgba(84, 84, 100, 0.14)',
		switchBg: 'rgba(84, 84, 100, 0.2)',
		indicator: '@accent',
		mentionMe: '#a44c6a',
		messageBg: '@bg',
		navActive: '@accent',
		accentedBg: ':alpha<0.15<@accent',
		codeNumber: '#a44c6a',
		codeString: '#5a6f3f',
		fgOnAccent: '#f2ecbc',
		fgOnWhite: '#545464',
		infoWarnBg: '#f9d791',
		infoWarnFg: '#635e34',
		codeBoolean: '#9e5400',
		dateLabelFg: '@fg',
		inputBorder: 'rgba(84, 84, 100, 0.2)',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		navIndicator: '@indicator',
		fgHighlighted: '#43436c',
		panelHeaderBg: ':darken<2<@panel',
		panelHeaderFg: '@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '@accent',
		htmlThemeColor: '@bg',
		panelHighlight: ':darken<3<@panel',
		scrollbarHandle: 'rgba(84, 84, 100, 0.25)',
		inputBorderHover: 'rgba(84, 84, 100, 0.4)',
		scrollbarHandleHover: 'rgba(84, 84, 100, 0.45)',
		deckBg: '#dcd5ac',

		// ---- NoteDeck 独自 ----
		accentText: '#46608d',
		fgMuted: '#6c695c',
		// フォーカスリングは accent (lotusBlue4) と区別できる lotusOrange
		focusRing: '#cc6d00',
		hairline: 'rgba(84, 84, 100, 0.1)',
		overlayDark: 'rgba(84, 84, 100, 0.5)',
		overlayLightbox: 'rgba(22, 22, 29, 0.85)',
		inlineCodeBg: '#e7dba0',
		inlineCodeFg: '@fg',
		'shadow-contact': 'rgba(84, 84, 100, 0.08)',
		'shadow-ambient': 'rgba(84, 84, 100, 0.15)',
		// 通知アイコンの塗り (白アイコンが乗る)
		eventReaction: '#cc6d00',
		eventReply: '#4e8ca2',
		eventRenote: '#6f894e',
		eventFollow: '#5e857a',
		eventAchievement: '#836f4a',
		eventLogin: '#5d57a3',
		eventOther: '#716e61',
		statusOnline: '#6f894e',
		statusActive: '#cc6d00',
		statusOffline: '#c84053',
		statusUnknown: '#716e61',
		modePolling: '#624c83',
		spotlight: '@warn',
		spotlightAlt: '#de9800',
		replyHover: '#4e8ca2',
		reactionHover: '#cc6d00',
		// コード面: 面 = lotusWhite3 / float = lotusWhite0 / 選択 = lotusViolet3 / 補完 = lotusBlue1 / 検索 = lotusBlue2
		codeEditorBg: '#f2ecbc',
		codeEditorFg: '#545464',
		codeEditorFgMuted: '#6c695c',
		codeEditorPanelBg: '#d5cea3',
		codeEditorPanelBorder: '#716e61',
		codeEditorSelectionBg: '#c9cbd1',
