		codeEditorActiveLineBg: '#e7dba0',
		codeEditorMatchBg: 'rgba(181, 203, 210, 0.7)',
		codeEditorMatchBorder: '#4e8ca2',
		// トークン: statement = lotusViolet4 / string = lotusGreen / number = lotusPink / identifier = lotusYellow / fun = lotusBlue4 / type = lotusAqua2 / special = lotusTeal2 (keyword・fun 以外は暗く調整)
		codeKeyword: '#624c83',
		codeComment: '#716e61',
		codeVariable: '#706b3b',
		codeFunction: '#4d699b',
		codeType: '#4f7067',
		codeLink: '#406d99',
		// 差分: 行は lotusGreen3 / lotusRed4、語は lotusGreen2 / lotusRed2
		diffInsertBg: '#b7d0ae',
		diffInsertTextBg: 'rgba(110, 145, 95, 0.4)',
		diffDeleteBg: '#d9a594',
		diffDeleteTextBg: 'rgba(215, 71, 75, 0.35)',
	},
}
