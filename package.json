{
  "name": "misstore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NoteDeck Store",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons:sync": "node scripts/sync-icons.js",
    "registry:build": "node scripts/build-registry.js",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "contract:sync": "node scripts/sync-notedeck-contract.mjs",
    "contract:verify": "node scripts/verify-contract.mjs",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "shiki": "^4.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@syuilo/aiscript": "1.2.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "json5": "^2.2.3",
    "lucide-static": "^1.12.0",
    "simple-icons": "^16.18.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.2",
    "vue-tsc": "^2.2.8",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@11.20.0"
}
