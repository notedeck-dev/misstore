// Workers Static Assets 設定。Phase 1 (#31) で "main"(Worker 本体)と
// "run_worker_first": ["/api/*"]、D1/KV バインディングを追加する。
// それまでは静的アセットのみの Worker として動作し、/registry/* を含む
// 全パスが静的配信される(security-principles.md P2 と整合)。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misstore",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
